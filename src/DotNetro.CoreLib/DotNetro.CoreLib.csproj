<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <AssemblyName>DotNetro.CoreLib</AssemblyName>
    <RootNamespace>DotNetro</RootNamespace>

    <!--
      DotNetro's own core library: it defines System.Object and friends itself, so it is
      compiled with no reference to any framework assembly. It is never loaded by the
      .NET runtime; the DotNetro compiler reads it as metadata + IL and translates it
      to 6502. Programs are still compiled by Roslyn against the standard reference
      assemblies, and dnrc redirects those references here (see TypeSystemContext).
    -->
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The primitive structs' value fields are never assigned in C#; the compiler gives them their layout. -->
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8021</NoWarn>

    <!--
      This library is not executed as .NET; it is transpiled to 6502 by the
      IL→MIR translator, which supports only a subset of IL. Force optimized
      codegen even in Debug so the runtime helpers compile to the same minimal
      IL the Release build (and CI's Release run) already handles — e.g.
      ConsoleHelper.WriteLineString's loop stays `ldind.u1; dup; brtrue` instead
      of the unoptimized `cgt.un`-against-zero form the translator can't yet
      lower. Keeps Debug and Release builds of the compiler consistent.
    -->
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
