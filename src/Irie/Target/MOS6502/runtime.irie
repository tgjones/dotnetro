; MOS6502 runtime — hand-written MIR loaded as an embedded resource by
; MOS6502Target.GetRuntime(). Functions here are appended to the MirModule
; produced by IL→MIR translation so the resulting program links.

; Indirect-call trampoline. MOS6502CallLowering.LowerIndirectCall parks the
; target address in RC16/RC17 (the zero-page bytes of those registers) and emits
; `jsr.abs @__call_indirect_trampoline`. The trampoline then dispatches via
; `JMP (RC16)`, which reads the 16-bit target from RC16/RC17's zero-page address.
func @__call_indirect_trampoline : () -> void {
bb0():
    [liveins: $28]    ; $28 = RC16 (physreg 12 + 16)
    mos6502.jmp.ind $28
}

; @HeapStart : () -> ptr — where the managed heap begins: the first byte after the
; program image (code, data and zero-initialised globals), which the binary encoder
; defines as @__image_end. Backs ManagedHeap.HeapStart (ManagedHeap.cs).
func @HeapStart : () -> ptr {
bb0():
    %0 : ptr = mem.symbol @__image_end
    core.return %0
}
