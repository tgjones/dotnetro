<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <!-- The lit tests run the compiler in-process, and the JIT never optimizes a Debug assembly: it is several times
         slower there. Build with -p:Optimize=false to step through the compiler in a debugger. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Target/MOS6502/runtime.irie" />
    <EmbeddedResource Include="Target/MOS6502/libcalls.s" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Irie.Tests" />
  </ItemGroup>

</Project>
