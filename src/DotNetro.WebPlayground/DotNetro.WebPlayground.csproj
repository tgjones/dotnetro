<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Vite/TypeScript shell lives in ClientApp and has its own build; keep MSBuild globs out of node_modules. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/**;spike/**</DefaultItemExcludes>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <!-- Roslyn ships a satellite assembly per language per assembly; the playground is English-only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetro.Compiler\DotNetro.Compiler.csproj" />
    <ProjectReference Include="..\DotNetro.CoreLib.BbcMicro\DotNetro.CoreLib.BbcMicro.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DotNetro.CoreLib.C64\DotNetro.CoreLib.C64.csproj" ReferenceOutputAssembly="false" />
    <!-- The core library is compiled by the user's program at link time, not executed
         here, so it is shipped as data (embedded below) rather than referenced. -->
  </ItemGroup>

  <!--
    Compile-time and link-time assemblies, embedded as data (see AssemblySet.cs):
      * System.Runtime / System.Console *reference* assemblies from the targeting pack
        serve Roslyn only (user code is compiled against them).
      * DotNetro.CoreLib.dll (one build per target) is the core library the DotNetro compiler links in; it
        redirects every framework reference in the user's program to it.
  -->
  <Target Name="EmbedPlaygroundAssemblies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveTargetingPackAssets;ResolveProjectReferences">
    <MSBuild Projects="..\DotNetro.CoreLib.BbcMicro\DotNetro.CoreLib.BbcMicro.csproj" Targets="GetTargetPath" SkipNonexistentTargets="false">
      <Output TaskParameter="TargetOutputs" ItemName="_PlaygroundRuntimeLib" />
    </MSBuild>
    <MSBuild Projects="..\DotNetro.CoreLib.C64\DotNetro.CoreLib.C64.csproj" Targets="GetTargetPath" SkipNonexistentTargets="false">
      <Output TaskParameter="TargetOutputs" ItemName="_PlaygroundRuntimeLibC64" />
    </MSBuild>
    <ItemGroup>
      <_PlaygroundRef Include="@(Reference)" Condition="'%(Filename)' == 'System.Runtime' Or '%(Filename)' == 'System.Console'" />
      <EmbeddedResource Include="@(_PlaygroundRef)" LogicalName="assemblies/%(Filename)%(Extension)" />
      <!-- One core library per target, keyed DotNetro.CoreLib.<target id> (see AssemblySet). -->
      <EmbeddedResource Include="@(_PlaygroundRuntimeLib)" LogicalName="assemblies/DotNetro.CoreLib.bbcmicro.dll" />
      <EmbeddedResource Include="@(_PlaygroundRuntimeLibC64)" LogicalName="assemblies/DotNetro.CoreLib.c64.dll" />
    </ItemGroup>
  </Target>

</Project>
