func @many_values : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.addi %0, %1
    %3 : i32 = arith.addi %2, %0
    %4 : i32 = arith.addi %3, %1
    %5 : i32 = arith.addi %4, %0
    %6 : i32 = arith.addi %5, %1
