; CHECK: bb0(%0 : i8):
; CHECK:     %1 : i32 = cast.zext %0
; CHECK:     %2 : i32 = arith.constant 100
; CHECK:     %3 : i1 = arith.cmpi ult, %1, %2
; CHECK:     core.return %3
; CHECK: }
; CHECK:
; CHECK: func @UnsignedOnNegative : (i8) -> i1 {
; CHECK: bb0(%0 : i8):
; CHECK:     %1 : i32 = cast.sext %0
; CHECK:     %2 : i32 = arith.constant 256
; CHECK:     %3 : i1 = arith.cmpi ult, %1, %2
; CHECK:     core.return %3
; CHECK: }
; CHECK:
; CHECK: func @InsideLoop : (i8) -> i32 {
; CHECK: bb0(%0 : i8):
; CHECK:     %1 : i32 = arith.constant 0
; CHECK:     cf.br bb1(%1)
; CHECK: bb1(%2 : i32):
; CHECK:     %3 : i32 = arith.constant 10
; CHECK:     %4 : i1 = arith.cmpi ult, %2, %3
; CHECK:     cf.cond_br %4, bb2(%2), bb3(%2)
; CHECK: bb2(%9 : i32):
; CHECK:     %5 : i32 = arith.constant 16
; CHECK:     %11 : i1 = arith.constant 1
; CHECK:     %7 : i32 = arith.constant 1
; CHECK:     %8 : i32 = arith.addi %9, %7
; CHECK:     cf.cond_br %11, bb1(%8), bb3(%9)
; CHECK: bb3(%10 : i32):
; CHECK:     core.return %10
; CHECK: }
; CHECK:
; CHECK: func @UnsignedQuotientSign : (i32, i32) -> i1 {
; CHECK: bb0(%0 : i32, %1 : i32):
; CHECK:     %2 : i32 = arith.udivi %0, %1
; CHECK:     %3 : i32 = arith.constant 0
; CHECK:     %4 : i1 = arith.cmpi sge, %2, %3
; CHECK:     core.return %4
; CHECK: }
