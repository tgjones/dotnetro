; CHECK: bb0(%0 : i8):
; CHECK:     %1 : i32 = cast.zext %0
; CHECK:     %2 : i32 = arith.constant 256
; CHECK:     %4 : i1 = arith.constant 0
; CHECK:     core.return %4
; CHECK: }
; CHECK:
