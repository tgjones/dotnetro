; CHECK:     %2 : i32 = arith.constant 10
; CHECK:     %3 : i1 = arith.cmpi ult, %1, %2
; CHECK:     cf.cond_br %3, bb1(%1), bb2
; CHECK: bb1(%4 : i32):
; CHECK:     %5 : i32 = arith.constant 9
; CHECK:     %8 : i1 = arith.constant 1
; CHECK:     core.return %8
; CHECK: bb2():
; CHECK:     %7 : i1 = arith.constant 0
; CHECK:     core.return %7
; CHECK: }
