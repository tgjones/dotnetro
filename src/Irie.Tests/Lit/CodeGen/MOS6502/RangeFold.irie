; RUN: @iriec --target mos6502 --run-pass RangeFold @file

; A compare the operand ranges decide becomes an i1 constant; a compare they leave open stays.

; A zero-extended byte is always below 256, never at or above it.
func @ByteBelow256 : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i32 = cast.zext %0
    %2 : i32 = arith.constant 256
    %3 : i1 = arith.cmpi ult, %1, %2
    core.return %3
}

func @ByteAtLeast256 : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i32 = cast.zext %0
    %2 : i32 = arith.constant 256
    %3 : i1 = arith.cmpi uge, %1, %2
    core.return %3
}

; Disjoint ranges are never equal.
func @DisjointEq : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i32 = cast.zext %0
    %2 : i32 = arith.constant 1000
    %3 : i1 = arith.cmpi eq, %1, %2
    core.return %3
}

; The branch condition refines the counter on the body edge: i < 10 holds there, so i <= 9 is decided.
func @RefinedByBranch : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i32 = cast.zext %0
    %2 : i32 = arith.constant 10
    %3 : i1 = arith.cmpi ult, %1, %2
    cf.cond_br %3, bb1(%1), bb2()

bb1(%4 : i32):
    %5 : i32 = arith.constant 9
    %6 : i1 = arith.cmpi ule, %4, %5
    core.return %6

bb2():
    %7 : i1 = arith.constant 0
    core.return %7
}

; A full-range signed byte is always at most 127.
func @SignedByteAtMost127 : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i8 = arith.constant 127
    %2 : i1 = arith.cmpi sle, %0, %1
    core.return %2
}

; Overlapping ranges stay.
func @Overlapping : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i32 = cast.zext %0
    %2 : i32 = arith.constant 100
    %3 : i1 = arith.cmpi ult, %1, %2
    core.return %3
}

; An unsigned predicate on a possibly negative operand stays.
func @UnsignedOnNegative : (i8) -> i1 {
bb0(%0 : i8):
    %1 : i32 = cast.sext %0
    %2 : i32 = arith.constant 256
    %3 : i1 = arith.cmpi ult, %1, %2
    core.return %3
}

; In a counted loop the counter stays below the bound (the body edge passes the refined counter), so a test
; against a larger value is decided.
func @InsideLoop : (i8) -> i32 {
bb0(%0 : i8):
    %1 : i32 = arith.constant 0
    cf.br bb1(%1)

bb1(%2 : i32):
    %3 : i32 = arith.constant 10
    %4 : i1 = arith.cmpi ult, %2, %3
    cf.cond_br %4, bb2(%2), bb3(%2)

bb2(%9 : i32):
    %5 : i32 = arith.constant 16
    %6 : i1 = arith.cmpi ult, %9, %5
    %7 : i32 = arith.constant 1
    %8 : i32 = arith.addi %9, %7
    cf.cond_br %6, bb1(%8), bb3(%9)

bb3(%10 : i32):
    core.return %10
}

; An unsigned quotient or remainder can have the sign bit set: the signed compare must stay.
func @UnsignedQuotientSign : (i32, i32) -> i1 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.udivi %0, %1
    %3 : i32 = arith.constant 0
    %4 : i1 = arith.cmpi sge, %2, %3
    core.return %4
}

