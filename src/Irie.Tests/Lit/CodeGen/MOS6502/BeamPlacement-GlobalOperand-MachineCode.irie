; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "global_rw(*)" --exec "store_between(*)"

; The beam placement: a byte loaded from a global is read where it is by the ALU
; (ADC counter) when nothing writes memory before its last use, instead of being
; loaded into a register and parked. In `store_between` a store to the same global
; comes before the add, so the old value has to be loaded first.

; CHECK: global_rw:
; CHECK:     CLC
; CHECK:     ADC counter
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC counter+1
; CHECK:     STY counter
; CHECK:     STA counter+1
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS
; CHECK:
; CHECK: store_between:
; CHECK:     LDY counter
; CHECK:     STY $14
; CHECK:     LDY counter+1
; CHECK:     STA counter
; CHECK:     STX counter+1
; CHECK:     CLC
; CHECK:     ADC $14
; CHECK:     STY $14
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $14
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

global @counter : i16 = bytes "\x00\x00"

func @global_rw : (i16) -> i16 {
bb0(%0 : i16):
    %1 : ptr = mem.symbol @counter
    %2 : i16 = mem.load.i16 %1
    %3 : i16 = arith.addi %2, %0
    mem.store.i16 %1, %3
    core.return %3
}

func @store_between : (i16) -> i16 {
bb0(%0 : i16):
    %1 : ptr = mem.symbol @counter
    %2 : i16 = mem.load.i16 %1
    mem.store.i16 %1, %0
    %3 : i16 = arith.addi %2, %0
    core.return %3
}
