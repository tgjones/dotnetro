; RUN: @iriec --target mos6502 --emit=asm @file

; CHECK: TestFunction:
; CHECK:     STX $02
; CHECK:     AND $02
; CHECK:     ORA #$0F
; CHECK:     EOR #$55
; CHECK:     RTS

func @TestFunction : (i8, i8) -> i8 {
bb0(%0 : i8, %1 : i8):
    %2 : i8 = arith.and %0, %1
    %3 : i8 = arith.constant 15
    %4 : i8 = arith.or %2, %3
    %5 : i8 = arith.constant 85
    %6 : i8 = arith.xor %5, %4
    core.return %6
}
