; RUN: @iriec --target mos6502 --run-pass MOS6502AddressingModeSelector @file

; The instruction selector builds compares on $a (cmp.zp / cmp.imm). When the
; compared byte is in $x or $y (physregs 1 and 2), the addressing-mode selector
; refines the opcode to cpx / cpy, keeping the operand layout; an $a compare
; (physreg 0) is left alone.

; CHECK: func @cmp_xy : () -> void {
; CHECK: bb0():
; CHECK:     mos6502.cmp.imm $a, 5, implicit-def $n, implicit-def $z, implicit-def $c
; CHECK:     mos6502.cpx.imm $x, 6, implicit-def $n, implicit-def $z, implicit-def $c
; CHECK:     mos6502.cpy.imm $y, 7, implicit-def $n, implicit-def $z, implicit-def $c
; CHECK:     mos6502.cmp.zp $a, $zp4, implicit-def $n, implicit-def $z, implicit-def $c
; CHECK:     mos6502.cpx.zp $x, $zp5, implicit-def $n, implicit-def $z, implicit-def $c
; CHECK:     mos6502.cpy.zp $y, $zp6, implicit-def $n, implicit-def $z, implicit-def $c
; CHECK:     mos6502.rts
; CHECK: }

func @cmp_xy : () -> void {
bb0():
    mos6502.cmp.imm $0, 5, implicit-def $6, implicit-def $8, implicit-def $5
    mos6502.cmp.imm $1, 6, implicit-def $6, implicit-def $8, implicit-def $5
    mos6502.cmp.imm $2, 7, implicit-def $6, implicit-def $8, implicit-def $5
    mos6502.cmp.zp $0, $16, implicit-def $6, implicit-def $8, implicit-def $5
    mos6502.cmp.zp $1, $17, implicit-def $6, implicit-def $8, implicit-def $5
    mos6502.cmp.zp $2, $18, implicit-def $6, implicit-def $8, implicit-def $5
    mos6502.rts
}
