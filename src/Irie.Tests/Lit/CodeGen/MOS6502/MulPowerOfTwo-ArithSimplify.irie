; RUN: @iriec --target mos6502 --stop-after ArithSimplify @file

; ArithSimplify strength-reduces a multiply by a constant power of two (either
; operand order) to arith.shl, and a multiply by 1 to the operand itself.

; CHECK: func @MulBy8 : (i32) -> i32 {
; CHECK: bb0(%0 : i32):
; CHECK:     %3 : i8 = arith.constant 3
; CHECK:     %4 : i32 = arith.shl %0, %3
; CHECK:     core.return %4
; CHECK: }
; CHECK:
; CHECK: func @MulBy4Commuted : (i16) -> i16 {
; CHECK: bb0(%0 : i16):
; CHECK:     %3 : i8 = arith.constant 2
; CHECK:     %4 : i16 = arith.shl %0, %3
; CHECK:     core.return %4
; CHECK: }
; CHECK:
; CHECK: func @MulBy1 : (i8) -> i8 {
; CHECK: bb0(%0 : i8):
; CHECK:     core.return %0
; CHECK: }
; CHECK:
; CHECK: func @MulByTruncatedConstant : (i16) -> i16 {
; CHECK: bb0(%0 : i16):
; CHECK:     %1 : i32 = arith.constant 4
; CHECK:     %2 : i16 = cast.trunc %1
; CHECK:     %4 : i8 = arith.constant 2
; CHECK:     %5 : i16 = arith.shl %0, %4
; CHECK:     core.return %5
; CHECK: }

func @MulBy8 : (i32) -> i32 {
bb0(%0 : i32):
    %1 : i32 = arith.constant 8
    %2 : i32 = arith.muli %0, %1
    core.return %2
}

func @MulBy4Commuted : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 4
    %2 : i16 = arith.muli %1, %0
    core.return %2
}

func @MulBy1 : (i8) -> i8 {
bb0(%0 : i8):
    %1 : i8 = arith.constant 1
    %2 : i8 = arith.muli %0, %1
    core.return %2
}

; A front end narrowing an int32 factor to pointer width leaves a cast.trunc of
; the constant; the rule looks through it.
func @MulByTruncatedConstant : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i32 = arith.constant 4
    %2 : i16 = cast.trunc %1
    %3 : i16 = arith.muli %0, %2
    core.return %3
}
