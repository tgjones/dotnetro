; RUN: @iriec --target mos6502 --placement naive --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "add_i32(*, *)"

; The naive placement: every byte value has a home, an
; operation reads its operands from there (an immediate for a constant), works in
; A and writes its result to the result's home. The carry between the bytes of the
; add stays in C from one ADC to the next; nothing else lives in a register.

; CHECK: add_i32:
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK:     LDA $02
; CHECK:     STA $16
; CHECK:     LDA $03
; CHECK:     STA $17
; CHECK:     LDA $04
; CHECK:     STA $18
; CHECK:     LDA $05
; CHECK:     STA $19
; CHECK:     LDA $06
; CHECK:     STA $1A
; CHECK:     LDA $07
; CHECK:     STA $1B
; CHECK:     CLC
; CHECK:     LDA $14
; CHECK:     ADC $18
; CHECK:     STA $1C
; CHECK:     LDA $15
; CHECK:     ADC $19
; CHECK:     STA $1D
; CHECK:     LDA $16
; CHECK:     ADC $1A
; CHECK:     STA $1E
; CHECK:     LDA $17
; CHECK:     ADC $1B
; CHECK:     STA $1F
; CHECK:     LDA $1E
; CHECK:     STA $02
; CHECK:     LDA $1F
; CHECK:     STA $03
; CHECK:     LDX $1D
; CHECK:     LDA $1C
; CHECK:     RTS

func @add_i32 : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.addi %0, %1
    core.return %2
}
