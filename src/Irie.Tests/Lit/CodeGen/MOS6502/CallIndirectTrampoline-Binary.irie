; RUN: @iriec --target mos6502 --emit=bin --origin=0x1000 @file | @irie-mc --hex-dump

; Exercises the indirect-call trampoline used by callvirt lowering: the
; target address is parked in zero-page bytes $10/$11 (RC16/RC17) by
; MOS6502CallLowering, then this trampoline dispatches via `JMP ($10)`.
;
;   $1000: JMP ($0010)     ; 6C 10 00

; CHECK: 00000000: 6C 10 00

func @__call_indirect_trampoline : () -> void {
bb0():
    mos6502.jmp.ind 16
}
