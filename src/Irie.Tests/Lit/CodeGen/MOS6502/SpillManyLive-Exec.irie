; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "spill_many(buf(112))"

; More live bytes than zero page can hold for one function: fourteen i64 values
; (112 bytes) are all live across a call, more than the 96 homes the allocator may
; use, so the surplus is spilled to frame slots. Homes are unbounded in principle
; (the layout only fails when the whole call path exceeds the zero-page window), but
; the allocator's pool is finite, so this keeps the spill and reload path exercised
; and executed.

func @g : () -> void {
bb0():
    core.return
}

func @spill_many : (ptr) -> i64 {
bb0(%0 : ptr):
    %1 : i16 = arith.constant 0
    %2 : ptr = mem.ptradd %0, %1
    %3 : i64 = mem.load.i64 %2
