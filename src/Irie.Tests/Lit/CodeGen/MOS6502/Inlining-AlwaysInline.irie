; RUN: @iriec --target mos6502 --run-pass Inlining @file

; A callee with a loop and two call sites is too big to share by default; `alwaysinline` inlines it at both.
func alwaysinline @SumTo : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 0
    cf.br bb1(%1, %0)
bb1(%2 : i16, %3 : i16):
    %4 : i16 = arith.constant 0
    %5 : i1 = arith.cmpi eq, %3, %4
    cf.cond_br %5, bb3, bb2
bb2():
    %6 : i16 = arith.addi %2, %3
    %7 : i16 = arith.constant 1
    %8 : i16 = arith.subi %3, %7
    cf.br bb1(%6, %8)
bb3():
    core.return %2
}

func @TwoCalls : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i16 = call.func @SumTo, %0
    %3 : i16 = call.func @SumTo, %1
    %4 : i16 = arith.addi %2, %3
    core.return %4
}

; `noinline` wins over `alwaysinline`.
func noinline alwaysinline @Kept : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}

func @CallsKept : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Kept, %0
    core.return %1
}

