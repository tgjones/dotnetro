; CHECK:     %22 : i16 = arith.subi %17, %21
; CHECK:     cf.br bb4(%20, %22)
; CHECK: bb6():
; CHECK:     %4 : i16 = arith.addi %7, %16
; CHECK:     core.return %4
; CHECK: }
