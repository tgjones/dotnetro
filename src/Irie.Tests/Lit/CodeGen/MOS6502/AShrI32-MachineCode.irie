; RUN: @iriec --target mos6502 --emit=asm @file

; CHECK: TestFunction:
; CHECK:     LDA $03
; CHECK:     BMI .bb3
; CHECK: .bb1:
; CHECK:     LDY #$00
; CHECK: .bb2:
; CHECK:     CMP #$80
; CHECK:     ROR
; CHECK:     STA $14
; CHECK:     LDA $02
; CHECK:     ROR
; CHECK:     STA $15
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     STA $16
; CHECK:     LDA $14
; CHECK:     CMP #$80
; CHECK:     ROR
; CHECK:     STA $02
; CHECK:     LDA $15
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     LDA $16
; CHECK:     ROR
; CHECK:     STY $03
; CHECK:     RTS
func @TestFunction : (i32) -> i32 {
bb0(%0 : i32):
    %1 : i8 = arith.constant 10
    %2 : i32 = arith.ashr %0, %1
    core.return %2
}
