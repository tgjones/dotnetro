; RUN: @iriec --target mos6502 --emit=asm @file

; CHECK: TestFunction:
; CHECK:     LDA $03
; CHECK:     LSR
; CHECK:     TAY
; CHECK:     LDA $02
; CHECK:     ROR
; CHECK:     STA $14
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     LSR
; CHECK:     TAY
; CHECK:     LDA $14
; CHECK:     ROR
; CHECK:     STA $15
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     LSR
; CHECK:     TAY
; CHECK:     LDA $15
; CHECK:     ROR
; CHECK:     STA $16
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     LSR
; CHECK:     TAY
; CHECK:     LDA $16
; CHECK:     ROR
; CHECK:     STA $17
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     STA $18
; CHECK:     TYA
; CHECK:     LSR
; CHECK:     STA $02
; CHECK:     LDA $17
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     LDA $18
; CHECK:     ROR
; CHECK:     LDY #$00
; CHECK:     STY $03
; CHECK:     RTS
func @TestFunction : (i32) -> i32 {
bb0(%0 : i32):
    %1 : i8 = arith.constant 13
    %2 : i32 = arith.lshr %0, %1
    core.return %2
}
