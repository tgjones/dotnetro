; RUN: @iriec --target mos6502 --run-pass Inlining @file

; A callee with one call site is spliced into its caller and removed from the module.
func @Double : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.addi %0, %0
    core.return %1
}

func @UsesDouble : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Double, %0
    %2 : i16 = arith.constant 1
    %3 : i16 = arith.addi %1, %2
    core.return %3
}

; A callee that costs next to nothing is copied to each of its call sites, and removed once none is left.
func @Identity : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}

func @TwoSites : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i16 = call.func @Identity, %0
    %3 : i16 = call.func @Identity, %1
    %4 : i16 = arith.addi %2, %3
    core.return %4
}

; A callee with several call sites that does real work stays a function of its own.
func @Wide : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.addi %0, %1
    %3 : i32 = arith.subi %2, %1
    %4 : i32 = arith.addi %3, %0
    core.return %4
}

func @CallsWideTwice : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = call.func @Wide, %0, %1
    %3 : i32 = call.func @Wide, %2, %1
    core.return %3
}

; A callee of several blocks: the call's block is split, the result becomes a block parameter.
func @Max : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i1 = arith.cmpi sgt, %0, %1
    cf.cond_br %2, bb1, bb2
bb1():
    core.return %0
bb2():
    core.return %1
}

func @UsesMax : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i16 = call.func @Max, %0, %1
    %3 : i16 = arith.addi %2, %2
    core.return %3
}

