; RUN: @iriec --target mos6502 --emit=asm @file

; Companion to CallFuncCrossLive-MachineCode.irie for a 16-bit (i16) value live
; across two call.func — the pointer/loop shape. Both pointer bytes must survive
; the calls, so the RA parks them in two homes ($14/$15 once program layout has
; placed this function's block of homes); nothing is saved or restored around the
; calls. An i16 is passed/returned LSB-first in $a / $x.

; CHECK: TestCrossCall16:
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK:     JSR Callee
; CHECK:     LDX $15
; CHECK:     LDA $14
; CHECK:     JMP Callee

func @TestCrossCall16 : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Callee, %0
    %2 : i16 = call.func @Callee, %0
    core.return %2
}
