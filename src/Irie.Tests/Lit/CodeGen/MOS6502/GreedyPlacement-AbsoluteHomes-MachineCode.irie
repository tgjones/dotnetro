func @many_values : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.addi %0, %1
    %3 : i32 = arith.addi %2, %0
    %4 : i32 = arith.addi %3, %1
    %5 : i32 = arith.addi %4, %0
    %6 : i32 = arith.addi %5, %1
    %7 : i32 = arith.addi %6, %0
    %8 : i32 = arith.addi %7, %1
    %9 : i32 = arith.addi %8, %0
    %10 : i32 = arith.addi %9, %1
    %11 : i32 = arith.addi %10, %0
    %12 : i32 = arith.addi %11, %1
    %13 : i32 = arith.addi %12, %0
    %14 : i32 = arith.addi %13, %1
    %15 : i32 = arith.addi %14, %0
    %16 : i32 = arith.addi %15, %1
    %17 : i32 = arith.addi %16, %0
    %18 : i32 = arith.addi %17, %1
    %19 : i32 = arith.addi %18, %0
    %20 : i32 = arith.addi %19, %1
    %21 : i32 = arith.addi %20, %0
    %22 : i32 = arith.addi %21, %1
    %23 : i32 = arith.addi %22, %0
    %24 : i32 = arith.addi %23, %1
    %25 : i32 = arith.addi %24, %0
    %26 : i32 = arith.addi %25, %1
    %27 : i32 = arith.addi %26, %0
    %28 : i32 = arith.addi %27, %1
    %29 : i32 = arith.addi %28, %0
    %30 : i32 = arith.addi %29, %1
    %31 : i32 = arith.addi %30, %0
    %32 : i32 = arith.addi %31, %1
    %33 : i32 = arith.addi %32, %0
    %34 : i32 = arith.addi %33, %1
    %35 : i32 = arith.addi %34, %0
    %36 : i32 = arith.addi %35, %1
    %37 : i32 = arith.addi %36, %0
    %38 : i32 = arith.addi %37, %1
    %39 : i32 = arith.addi %38, %0
    %40 : i32 = arith.addi %39, %1
    %41 : i32 = arith.addi %40, %0
    core.return %41
}
