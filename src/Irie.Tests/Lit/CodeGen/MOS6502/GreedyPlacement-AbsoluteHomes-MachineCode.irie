; CHECK:     CLC
; CHECK:     TAY
; CHECK:     ADC $04
; CHECK:     STA $14
; CHECK:     TXA
; CHECK:     ADC $05
; CHECK:     STA $15
; CHECK:     LDA $02
; CHECK:     ADC $06
; CHECK:     STA $16
