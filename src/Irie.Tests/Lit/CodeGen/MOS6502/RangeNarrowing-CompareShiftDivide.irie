; CHECK: bb0(%0 : i8, %1 : i8):
; CHECK:     %2 : i32 in [-128, 127] = cast.sext %0
; CHECK:     %3 : i32 in [-128, 127] = cast.sext %1
; CHECK:     %4 : i1 = arith.cmpi ult, %2, %3
; CHECK:     core.return %4
; CHECK: }
; CHECK:
; CHECK: func @ShiftRight : (i16) -> i32 {
; CHECK: bb0(%0 : i16):
; CHECK:     %2 : i8 = arith.constant 4
; CHECK:     %7 : i16 = arith.lshr %0, %2
; CHECK:     %9 : i16 = arith.lshr %0, %2
; CHECK:     %11 : i16 = arith.addi %7, %9
; CHECK:     %5 : i32 in [0, 8190] = cast.zext %11
; CHECK:     core.return %5
; CHECK: }
; CHECK:
; CHECK: func @DivRem : (i8, i8) -> i32 {
; CHECK: bb0(%0 : i8, %1 : i8):
; CHECK:     %9 : i8 = arith.udivi %0, %1
; CHECK:     %12 : i8 = arith.uremi %0, %1
; CHECK:     %13 : i16 = cast.zext %12
; CHECK:     %15 : i16 = cast.zext %9
; CHECK:     %14 : i16 = arith.addi %15, %13
; CHECK:     %6 : i32 in [0, 509] = cast.zext %14
; CHECK:     core.return %6
; CHECK: }
; CHECK:
; CHECK: func @MultiplyBytes : (i8, i8) -> i32 {
; CHECK: bb0(%0 : i8, %1 : i8):
; CHECK:     %5 : i16 = cast.zext %1
; CHECK:     %7 : i16 = cast.zext %0
; CHECK:     %6 : i16 = arith.muli %7, %5
; CHECK:     %4 : i32 in [0, 65025] = cast.zext %6
; CHECK:     core.return %4
; CHECK: }
