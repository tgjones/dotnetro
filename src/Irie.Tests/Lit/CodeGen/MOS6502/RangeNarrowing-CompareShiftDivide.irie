; CHECK: bb0(%0 : i16):
; CHECK:     %6 : i16 = arith.constant 1000
; CHECK:     %3 : i1 = arith.cmpi eq, %0, %6
; CHECK:     core.return %3
; CHECK: }
; CHECK:
