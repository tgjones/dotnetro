; RUN: @iriec --target mos6502 --run-pass RangeNarrowing @file

; Compares narrow to the width both operands fit (signed predicates become unsigned on non-negative
; operands), and right shifts, unsigned divides and remainders narrow to the width of their operands.

func @CompareUnsigned : (i8, i8) -> i1 {
bb0(%0 : i8, %1 : i8):
    %2 : i32 = cast.zext %0
    %3 : i32 = cast.zext %1
    %4 : i1 = arith.cmpi slt, %2, %3
    core.return %4
}

func @CompareWithConstant : (i16) -> i1 {
bb0(%0 : i16):
    %1 : i32 = cast.zext %0
    %2 : i32 = arith.constant 1000
    %3 : i1 = arith.cmpi eq, %1, %2
    core.return %3
}

func @CompareSigned : (i8, i8) -> i1 {
bb0(%0 : i8, %1 : i8):
    %2 : i32 = cast.sext %0
    %3 : i32 = cast.sext %1
    %4 : i1 = arith.cmpi slt, %2, %3
    core.return %4
}

; An unsigned predicate on operands that may be negative stays wide.
func @CompareUnsignedPredicateOnSigned : (i8, i8) -> i1 {
bb0(%0 : i8, %1 : i8):
    %2 : i32 = cast.sext %0
    %3 : i32 = cast.sext %1
    %4 : i1 = arith.cmpi ult, %2, %3
    core.return %4
}

func @ShiftRight : (i16) -> i32 {
bb0(%0 : i16):
    %1 : i32 = cast.zext %0
    %2 : i8 = arith.constant 4
    %3 : i32 = arith.lshr %1, %2
    %4 : i32 = arith.ashr %1, %2
    %5 : i32 = arith.addi %3, %4
    core.return %5
}

func @DivRem : (i8, i8) -> i32 {
bb0(%0 : i8, %1 : i8):
    %2 : i32 = cast.zext %0
    %3 : i32 = cast.zext %1
    %4 : i32 = arith.udivi %2, %3
    %5 : i32 = arith.uremi %2, %3
    %6 : i32 = arith.addi %4, %5
    core.return %6
}

func @MultiplyBytes : (i8, i8) -> i32 {
bb0(%0 : i8, %1 : i8):
    %2 : i32 = cast.zext %0
    %3 : i32 = cast.zext %1
    %4 : i32 = arith.muli %2, %3
    core.return %4
}

