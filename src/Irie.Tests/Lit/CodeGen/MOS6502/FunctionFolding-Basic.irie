; CHECK:     %2 : i1 = arith.cmpi eq, %0, %1
; CHECK:     cf.cond_br %2, bb2, bb1
; CHECK: bb1():
; CHECK:     %3 : i16 = arith.constant 1
; CHECK:     %4 : i16 = arith.subi %0, %3
; CHECK:     %5 : i16 = call.func @CountDownA, %4
; CHECK:     core.return %5
; CHECK: bb2():
; CHECK:     core.return %0
; CHECK: }
; CHECK:
; CHECK: func noinline @KeptA : (i16) -> i16 {
; CHECK: bb0(%0 : i16):
; CHECK:     core.return %0
; CHECK: }
; CHECK:
; CHECK: func noinline @KeptB : (i16) -> i16 {
; CHECK: bb0(%0 : i16):
; CHECK:     core.return %0
; CHECK: }
; CHECK:
; CHECK: func @__entry : () -> void {
; CHECK: bb0():
; CHECK:     %0 : i16 = arith.constant 5
; CHECK:     %1 : i16 = call.func @CallerA, %0
; CHECK:     %2 : i16 = call.func @CallerA, %1
; CHECK:     %3 : i16 = call.func @CountDownA, %2
; CHECK:     %4 : i16 = call.func @AddOne, %3
; CHECK:     %5 : i16 = call.func @KeptB, %4
