; RUN: @iriec --target mos6502 --run-pass IdenticalFunctionFolding @file

; Identical bodies fold into the first of them, whatever the numbering of their registers; every call and
; every vtable slot naming a dropped function is redirected to the survivor.
func @AddOne : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 1
    %2 : i16 = arith.addi %0, %1
    core.return %2
}

func @AddOneToo : (i16) -> i16 {
bb0(%5 : i16):
    %9 : i16 = arith.constant 1
    %7 : i16 = arith.addi %5, %9
    core.return %7
}

; A different constant is a different function.
func @AddTwo : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 2
    %2 : i16 = arith.addi %0, %1
    core.return %2
}

; Callers whose callees fold become identical in turn.
func @CallerA : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @AddOne, %0
    core.return %1
}

func @CallerB : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @AddOneToo, %0
    core.return %1
}

; Self-recursive functions fold when they recurse the same way.
func @CountDownA : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 0
    %2 : i1 = arith.cmpi eq, %0, %1
    cf.cond_br %2, bb2, bb1
bb1():
    %3 : i16 = arith.constant 1
    %4 : i16 = arith.subi %0, %3
    %5 : i16 = call.func @CountDownA, %4
    core.return %5
bb2():
    core.return %0
}

func @CountDownB : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 0
    %2 : i1 = arith.cmpi eq, %0, %1
    cf.cond_br %2, bb2, bb1
bb1():
    %3 : i16 = arith.constant 1
    %4 : i16 = arith.subi %0, %3
    %5 : i16 = call.func @CountDownB, %4
    core.return %5
bb2():
    core.return %0
}

; `noinline` functions are left alone.
func noinline @KeptA : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}

func noinline @KeptB : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}

global @table : i32 = [@AddOneToo, @AddTwo]

func @__entry : () -> void {
bb0():
    %0 : i16 = arith.constant 5
    %1 : i16 = call.func @CallerA, %0
    %2 : i16 = call.func @CallerB, %1
    %3 : i16 = call.func @CountDownB, %2
    %4 : i16 = call.func @AddOneToo, %3
    %5 : i16 = call.func @KeptB, %4
    core.return
}

; CHECK: global @table : i32 = [@AddOne, @AddTwo]
; CHECK:
; CHECK: func @AddOne : (i16) -> i16 {
; CHECK: bb0(%0 : i16):
; CHECK:     %1 : i16 = arith.constant 1
; CHECK:     %2 : i16 = arith.addi %0, %1
; CHECK:     core.return %2
; CHECK: }
; CHECK:
; CHECK: func @AddTwo : (i16) -> i16 {
; CHECK: bb0(%0 : i16):
; CHECK:     %1 : i16 = arith.constant 2
; CHECK:     %2 : i16 = arith.addi %0, %1
; CHECK:     core.return %2
; CHECK: }
; CHECK:
; CHECK: func @CallerA : (i16) -> i16 {
