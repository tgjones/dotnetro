; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "set_prefix(0..8, 0|0x5a|0x7f)"

; mem.set with a run-time byte count, lowered to the memset libcall (libcalls.s): setting the
; first n bytes of @destination leaves the rest alone. The emulator's result must equal the
; interpreter's for every n and value.

global @destination : i64 = bytes "\x61\x62\x63\x64\x65\x66\x67\x68"

func @set_prefix : (i16, i8) -> i64 {
bb0(%0 : i16, %1 : i8):
    %2 : ptr = mem.symbol @destination
    mem.set %2, %1, %0
    %3 : i64 = mem.load.i64 %2
    core.return %3
}
