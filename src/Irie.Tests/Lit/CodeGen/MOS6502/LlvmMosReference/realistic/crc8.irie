; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "crc8(buf(16), 0..16)"

; Corpus: llvm-mos-reference/realistic/crc8
; Bitwise CRC8 over a byte buffer; the uchar arithmetic is done at i8.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/realistic/crc8.s; close gaps via irie-report.

; CHECK: crc8:
; CHECK:     LDY #$00
; CHECK:     STA $17
; CHECK:     STX $18
; CHECK:     STY $15
; CHECK:     LDX #$FF
; CHECK:     STX $14
; CHECK: .bb1:
; CHECK:     LDA $15
; CHECK:     STY $16
; CHECK:     CMP $03
; CHECK:     BCC .bb2
; CHECK:     BNE .bb8
; CHECK:     CPY $02
; CHECK:     BCS .bb8
; CHECK: .bb2:
; CHECK:     CLC
; CHECK:     LDA $17
; CHECK:     ADC $16
; CHECK:     TAX
; CHECK:     LDA $18
; CHECK:     ADC $15
; CHECK:     STX $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     LDA ($12),Y
; CHECK:     EOR $14
; CHECK:     STY $14
; CHECK: .bb3:
; CHECK:     LDX $14
; CHECK:     CPX #$08
; CHECK:     BCS .bb7
; CHECK: .bb4:
; CHECK:     TAX
; CHECK:     AND #$80
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ASL
; CHECK:     CPY #$00
; CHECK:     BNE .bb6
; CHECK: .bb5:
; CHECK:     LDX $14
; CHECK:     INX
; CHECK:     STX $14
; CHECK:     JMP .bb3
; CHECK: .bb6:
; CHECK:     EOR #$31
; CHECK:     JMP .bb5
; CHECK: .bb7:
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     LDA $16
; CHECK:     ADC #$01
; CHECK:     TAY
; CHECK:     LDA $15
; CHECK:     ADC #$00
; CHECK:     STX $14
; CHECK:     STA $15
; CHECK:     JMP .bb1
; CHECK: .bb8:
; CHECK:     LDA $14
; CHECK:     RTS

func @crc8 : (ptr, i16) -> i8 {
bb0(%0 : ptr, %1 : i16):
    %2 : i8 = arith.constant 255
    %3 : i16 = arith.constant 0
    cf.br bb1(%3, %2)
bb1(%4 : i16, %5 : i8):
    %6 : i1 = arith.cmpi ult, %4, %1
    cf.cond_br %6, bb2(%4, %5), bb7(%5)
bb2(%7 : i16, %8 : i8):
    %9 : ptr = mem.ptradd %0, %7
    %10 : i8 = mem.load.i8 %9
    %11 : i8 = arith.xor %8, %10
    %12 : i16 = arith.constant 0
    cf.br bb3(%7, %11, %12)
bb3(%13 : i16, %14 : i8, %15 : i16):
    %16 : i16 = arith.constant 8
    %17 : i1 = arith.cmpi slt, %15, %16
    cf.cond_br %17, bb4(%13, %14, %15), bb8(%13, %14)
bb4(%18 : i16, %19 : i8, %20 : i16):
    %21 : i8 = arith.constant 128
    %22 : i8 = arith.and %19, %21
    %23 : i8 = arith.constant 0
    %24 : i1 = arith.cmpi ne, %22, %23
    %25 : i8 = arith.constant 1
    %26 : i8 = arith.shl %19, %25
    cf.cond_br %24, bb5(%18, %26, %20), bb6(%18, %26, %20)
bb5(%27 : i16, %28 : i8, %29 : i16):
    %30 : i8 = arith.constant 49
    %31 : i8 = arith.xor %28, %30
    cf.br bb9(%27, %31, %29)
bb6(%32 : i16, %33 : i8, %34 : i16):
    cf.br bb9(%32, %33, %34)
bb9(%35 : i16, %36 : i8, %37 : i16):
    %38 : i16 = arith.constant 1
    %39 : i16 = arith.addi %37, %38
    cf.br bb3(%35, %36, %39)
bb8(%40 : i16, %41 : i8):
    %42 : i16 = arith.constant 1
    %43 : i16 = arith.addi %40, %42
    cf.br bb1(%43, %41)
bb7(%44 : i8):
    core.return %44
}
