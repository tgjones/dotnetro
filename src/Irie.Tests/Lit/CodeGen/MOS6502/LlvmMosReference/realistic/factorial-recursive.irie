; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "factorial(0..8)"

; Corpus: llvm-mos-reference/realistic/factorial-recursive
; n <= 1 ? 1 : n * factorial(n - 1).
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/realistic/factorial-recursive.s; close gaps via irie-report.

; CHECK: factorial:
; CHECK:     STA $14
; CHECK:     LDA #$00
; CHECK:     EOR #$80
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     EOR #$80
; CHECK:     STA $15
; CHECK:     STX $16
; CHECK:     CPY $15
; CHECK:     BCC .bb3
; CHECK:     BNE .bb1
; CHECK:     LDA #$01
; CHECK:     CMP $14
; CHECK:     BCC .bb3
; CHECK: .bb1:
; CHECK:     LDX #$00
; CHECK:     LDY #$01
; CHECK: .bb2:
; CHECK:     TYA
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     SEC
; CHECK:     LDA $14
; CHECK:     SBC #$01
; CHECK:     STA $17
; CHECK:     LDA $16
; CHECK:     SBC #$00
; CHECK:     TAX
; CHECK:     LDA $17
; CHECK:     TAY
; CHECK:     LDA $14
; CHECK:     PHA
; CHECK:     LDA $16
; CHECK:     PHA
; CHECK:     TYA
; CHECK:     JSR factorial
; CHECK:     TAY
; CHECK:     PLA
; CHECK:     STA $16
; CHECK:     PLA
; CHECK:     STA $14
; CHECK:     TYA
; CHECK:     STA $02
; CHECK:     STX $03
; CHECK:     LDX $16
; CHECK:     LDA $14
; CHECK:     JSR __mulhi3
; CHECK:     TAY

func @factorial : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 1
    %2 : i1 = arith.cmpi sle, %0, %1
    cf.cond_br %2, bb1(), bb2()
bb1():
    core.return %1
bb2():
    %3 : i16 = arith.subi %0, %1
    %4 : i16 = call.func @factorial, %3
    %5 : i16 = arith.muli %0, %4
    core.return %5
}
