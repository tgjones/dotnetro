; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "gcd(1..40, 1..40)"

; Corpus: llvm-mos-reference/realistic/gcd
; Euclid's algorithm with a signed remainder.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/realistic/gcd.s; close gaps via irie-report.

; CHECK: gcd:
; CHECK:     TAY
; CHECK:     LDA $14
; CHECK:     PHA
; CHECK:     LDA $15
; CHECK:     PHA
; CHECK:     TYA
; CHECK:     STA $05
; CHECK:     STX $04
; CHECK:     LDA $02
; CHECK:     STA $15
; CHECK:     LDA $03
; CHECK:     STA $14
; CHECK: .bb1:
; CHECK:     LDA $14
; CHECK:     BNE .bb3
; CHECK:     LDA $15
; CHECK:     BNE .bb3
; CHECK: .bb2:
; CHECK:     LDA $05
; CHECK:     LDX $04
; CHECK:     TAY
; CHECK:     PLA
; CHECK:     STA $15
; CHECK:     PLA
; CHECK:     STA $14
; CHECK:     TYA
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDA $04
; CHECK:     BMI .bb8
; CHECK: .bb4:
; CHECK:     LDA #$00
; CHECK:     STA $03
; CHECK: .bb5:
; CHECK:     LDA $14
; CHECK:     BMI .bb9
; CHECK: .bb6:
; CHECK:     LDA #$00
; CHECK:     STA $07
; CHECK: .bb7:
; CHECK:     LDA $05
; CHECK:     LDX $04
; CHECK:     LDY $03
; CHECK:     STY $02
; CHECK:     LDY $15
; CHECK:     STY $04
; CHECK:     LDY $14
; CHECK:     STY $05
; CHECK:     LDY $07
; CHECK:     STY $06
; CHECK:     JSR __modsi3
; CHECK:     LDY $15
; CHECK:     STY $05
; CHECK:     LDY $14
; CHECK:     STY $04
; CHECK:     STA $15
; CHECK:     STX $14
; CHECK:     JMP .bb1
; CHECK: .bb8:
; CHECK:     LDA #$FF
; CHECK:     STA $03
; CHECK:     JMP .bb5
; CHECK: .bb9:
; CHECK:     LDA #$FF
; CHECK:     STA $07

func @gcd : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    cf.br bb1(%0, %1)
bb1(%2 : i16, %3 : i16):
    %4 : i16 = arith.constant 0
    %5 : i1 = arith.cmpi ne, %3, %4
    cf.cond_br %5, bb2(%2, %3), bb3(%2)
bb2(%6 : i16, %7 : i16):
    %8 : i16 = arith.sremi %6, %7
    cf.br bb1(%7, %8)
bb3(%9 : i16):
    core.return %9
}
