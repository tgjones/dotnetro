; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "gcd(1..40, 1..40)"

; Corpus: llvm-mos-reference/realistic/gcd
; Euclid's algorithm with a signed remainder.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/realistic/gcd.s; close gaps via irie-report.

; CHECK: gcd:
; CHECK:     LDY $02
; CHECK:     STY $14
; CHECK:     LDY $03
; CHECK:     STY $15
; CHECK:     STA $16
; CHECK:     STX $17
; CHECK: .bb1:
; CHECK:     LDA $15
; CHECK:     BNE .bb3
; CHECK:     LDA $14
; CHECK:     BNE .bb3
; CHECK: .bb2:
; CHECK:     LDX $17
; CHECK:     LDA $16
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDA $17
; CHECK:     BMI .bb8
; CHECK: .bb4:
; CHECK:     LDX #$00
; CHECK: .bb5:
; CHECK:     LDY $15
; CHECK:     BMI .bb9
; CHECK: .bb6:
; CHECK:     LDY #$00
; CHECK: .bb7:
; CHECK:     STX $02
; CHECK:     STX $03
; CHECK:     LDX $14
; CHECK:     STX $04
; CHECK:     LDX $15
; CHECK:     STX $05
; CHECK:     STY $06
; CHECK:     STY $07
; CHECK:     TAX
; CHECK:     LDA $16
; CHECK:     JSR __modsi3
; CHECK:     LDY $14
; CHECK:     STY $16
; CHECK:     STA $14
; CHECK:     LDY $15
; CHECK:     STY $17
; CHECK:     STX $15
; CHECK:     JMP .bb1
; CHECK: .bb8:
; CHECK:     LDX #$FF
; CHECK:     JMP .bb5
; CHECK: .bb9:

func @gcd : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    cf.br bb1(%0, %1)
bb1(%2 : i16, %3 : i16):
    %4 : i16 = arith.constant 0
    %5 : i1 = arith.cmpi ne, %3, %4
    cf.cond_br %5, bb2(%2, %3), bb3(%2)
bb2(%6 : i16, %7 : i16):
    %8 : i16 = arith.sremi %6, %7
    cf.br bb1(%7, %8)
bb3(%9 : i16):
    core.return %9
}
