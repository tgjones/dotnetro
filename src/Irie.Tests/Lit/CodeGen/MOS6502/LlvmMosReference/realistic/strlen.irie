; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "strlen_impl(buf(16)@0|1|2|5|9)"

; Corpus: llvm-mos-reference/realistic/strlen
; Incomparable: llvm-mos recognises the loop as strlen and tail-calls the library routine
; Pointer-walking loop over bytes; length is the pointer difference.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/realistic/strlen.s; close gaps via irie-report.

; CHECK: strlen_impl:
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK: .bb1:
; CHECK:     STA $12
; CHECK:     STX $13
; CHECK:     LDY #$00
; CHECK:     STA $16
; CHECK:     LDA ($12),Y
; CHECK:     BNE .bb3
; CHECK: .bb2:
; CHECK:     SEC
; CHECK:     LDA $16
; CHECK:     SBC $14
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     SBC $15
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     CLC
; CHECK:     LDA $16
; CHECK:     ADC #$01
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC #$00
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     JMP .bb1

func @strlen_impl : (ptr) -> i16 {
bb0(%0 : ptr):
    cf.br bb1(%0)
bb1(%1 : ptr):
    %2 : i8 = mem.load.i8 %1
    %3 : i8 = arith.constant 0
    %4 : i1 = arith.cmpi ne, %2, %3
    cf.cond_br %4, bb2(%1), bb3(%1)
bb2(%5 : ptr):
    %6 : i16 = arith.constant 1
    %7 : ptr = mem.ptradd %5, %6
    cf.br bb1(%7)
bb3(%8 : ptr):
    %9 : i16 = cast.ptrtoint %8
    %10 : i16 = cast.ptrtoint %0
    %11 : i16 = arith.subi %9, %10
    core.return %11
}
