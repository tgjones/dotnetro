; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "two_pointer_copy(buf(32), buf(32), 0..16)"

; Corpus: llvm-mos-reference/memory/two-pointer-copy
; for (i = 0; i < n; i++) dst[i] = src[i]; with i16 elements.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/memory/two-pointer-copy.s; close gaps via irie-report.

; CHECK: two_pointer_copy:
; CHECK:     LDY #$00
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK:     STY $16
; CHECK: .bb1:
; CHECK:     LDA $16
; CHECK:     EOR #$80
; CHECK:     TAX
; CHECK:     LDA $05
; CHECK:     EOR #$80
; CHECK:     STA $17
; CHECK:     STY $18
; CHECK:     CPX $17
; CHECK:     BCC .bb3
; CHECK:     BNE .bb2
; CHECK:     CPY $04
; CHECK:     BCC .bb3
; CHECK: .bb2:
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDA $18
; CHECK:     ASL
; CHECK:     TAX
; CHECK:     LDA $16
; CHECK:     ROL
; CHECK:     CLC
; CHECK:     STA $19
; CHECK:     TXA
; CHECK:     ADC $02
; CHECK:     TAY
; CHECK:     LDA $03
; CHECK:     ADC $19
; CHECK:     STY $12
; CHECK:     STA $13
; CHECK:     STY $1A
; CHECK:     LDY #$00
; CHECK:     STA $1B
; CHECK:     LDA ($12),Y
; CHECK:     LDY #$01
; CHECK:     STA $1C
; CHECK:     LDA ($12),Y
; CHECK:     CLC
; CHECK:     STA $1D
; CHECK:     TXA
; CHECK:     ADC $14
; CHECK:     TAX
; CHECK:     LDA $15
; CHECK:     ADC $19
; CHECK:     STX $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     STA $1E
; CHECK:     LDA $1C
; CHECK:     STA ($12),Y
; CHECK:     LDY #$01
; CHECK:     LDA $1D
; CHECK:     STA ($12),Y
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $18
; CHECK:     STA $18
; CHECK:     LDA $16
; CHECK:     ADC #$00
; CHECK:     STA $16
; CHECK:     LDY $18
; CHECK:     JMP .bb1

func @two_pointer_copy : (ptr, ptr, i16) -> void {
bb0(%0 : ptr, %1 : ptr, %2 : i16):
    %3 : i16 = arith.constant 0
    cf.br bb1(%3)
bb1(%4 : i16):
    %5 : i1 = arith.cmpi slt, %4, %2
    cf.cond_br %5, bb2(%4), bb3()
bb2(%6 : i16):
    %7 : i8 = arith.constant 1
    %8 : i16 = arith.shl %6, %7
    %9 : ptr = mem.ptradd %1, %8
    %10 : i16 = mem.load.i16 %9
    %11 : ptr = mem.ptradd %0, %8
    mem.store.i16 %11, %10
    %12 : i16 = arith.constant 1
    %13 : i16 = arith.addi %6, %12
    cf.br bb1(%13)
bb3():
    core.return
}
