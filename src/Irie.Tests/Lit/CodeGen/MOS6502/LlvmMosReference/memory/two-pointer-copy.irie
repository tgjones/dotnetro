; RUN: @iriec --target mos6502 --emit=asm @file

; Corpus: llvm-mos-reference/memory/two-pointer-copy
; for (i = 0; i < n; i++) dst[i] = src[i]; with i16 elements.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/memory/two-pointer-copy.s; close gaps via irie-report.

; CHECK: two_pointer_copy:
; CHECK:     STA $08
; CHECK:     LDA $02
; CHECK:     STA $07
; CHECK:     LDA $03
; CHECK:     STA $06
; CHECK:     LDA #$00
; CHECK:     STA $03
; CHECK:     LDA #$00
; CHECK:     STA $02
; CHECK: .bb1:
; CHECK:     LDA $02
; CHECK:     EOR #$80
; CHECK:     TAY
; CHECK:     LDA $05
; CHECK:     EOR #$80
; CHECK:     STA $09
; CHECK:     TYA
; CHECK:     CMP $09
; CHECK:     BCC .bb3
; CHECK:     BNE .bb2
; CHECK:     LDA $03
; CHECK:     CMP $04
; CHECK:     BCC .bb3
; CHECK: .bb2:
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDA $03
; CHECK:     ASL
; CHECK:     STA $0B
; CHECK:     LDA $02
; CHECK:     ROL
; CHECK:     STA $0A
; CHECK:     CLC
; CHECK:     LDA $0B
; CHECK:     STA $09
; CHECK:     LDA $07
; CHECK:     ADC $09
; CHECK:     TAY
; CHECK:     LDA $0A
; CHECK:     STA $09
; CHECK:     LDA $06
; CHECK:     ADC $09
; CHECK:     STY $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     LDA ($12),Y
; CHECK:     STA $0C
; CHECK:     LDY #$01
; CHECK:     LDA ($12),Y
; CHECK:     STA $09
; CHECK:     CLC
; CHECK:     LDA $08
; CHECK:     ADC $0B
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $0A
; CHECK:     STY $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     LDA $0C
; CHECK:     STA ($12),Y
; CHECK:     LDY #$01
; CHECK:     LDA $09
; CHECK:     STA ($12),Y
; CHECK:     CLC
; CHECK:     LDA $03
; CHECK:     ADC #$01
; CHECK:     STA $03
; CHECK:     LDA $02
; CHECK:     ADC #$00
; CHECK:     STA $02
; CHECK:     JMP .bb1

func @two_pointer_copy : (ptr, ptr, i16) -> void {
bb0(%0 : ptr, %1 : ptr, %2 : i16):
    %3 : i16 = arith.constant 0
    cf.br bb1(%3)
bb1(%4 : i16):
    %5 : i1 = arith.cmpi slt, %4, %2
    cf.cond_br %5, bb2(%4), bb3()
bb2(%6 : i16):
    %7 : i8 = arith.constant 1
    %8 : i16 = arith.shl %6, %7
    %9 : ptr = mem.ptradd %1, %8
    %10 : i16 = mem.load.i16 %9
    %11 : ptr = mem.ptradd %0, %8
    mem.store.i16 %11, %10
    %12 : i16 = arith.constant 1
    %13 : i16 = arith.addi %6, %12
    cf.br bb1(%13)
bb3():
    core.return
}
