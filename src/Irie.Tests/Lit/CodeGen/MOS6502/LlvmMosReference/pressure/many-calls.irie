; CHECK:     PLA
; CHECK:     STA $14
; CHECK:     TYA
; CHECK:     RTS

func @g : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}
func @many_calls : (i16, i16, i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16, %2 : i16, %3 : i16):
    %4 : i16 = call.func @g, %0
    %5 : i16 = call.func @g, %1
    %6 : i16 = arith.addi %4, %5
    %7 : i16 = call.func @g, %2
    %8 : i16 = call.func @g, %3
    %9 : i16 = arith.addi %7, %8
    %10 : i16 = arith.addi %6, %9
    %11 : i16 = arith.addi %10, %0
    %12 : i16 = arith.addi %11, %1
    %13 : i16 = arith.addi %12, %2
    %14 : i16 = arith.addi %13, %3
    core.return %14
}
