; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "many_calls(*, *, *, *)"

; Corpus: llvm-mos-reference/pressure/many-calls
; Four calls, with all four args needing to survive every call. Maximal
; caller-saved pressure: forces a cluster of spills around the JSRs; watch
; where Irie parks the live args across each call.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/pressure/many-calls.s; close gaps via irie-report.

; CHECK: g:
; CHECK:     RTS
; CHECK:
; CHECK: many_calls:
; CHECK:     STA $1C
; CHECK:     STX $1D
; CHECK:     LDY $02
; CHECK:     STY $16
; CHECK:     LDY $03
; CHECK:     STY $17
; CHECK:     LDY $04
; CHECK:     STY $18
; CHECK:     LDY $05
; CHECK:     STY $19
; CHECK:     LDY $06
; CHECK:     STY $1A
; CHECK:     LDY $07
; CHECK:     STY $1B
; CHECK:     JSR g
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK:     LDX $17
; CHECK:     LDA $16
; CHECK:     JSR g
; CHECK:     CLC
; CHECK:     ADC $14
; CHECK:     STA $14
; CHECK:     TXA
; CHECK:     ADC $15
; CHECK:     STA $15
; CHECK:     LDX $19
; CHECK:     LDA $18
; CHECK:     JSR g
; CHECK:     STA $1E
; CHECK:     STX $1F
; CHECK:     LDX $1B
; CHECK:     LDA $1A
; CHECK:     JSR g
; CHECK:     CLC
; CHECK:     ADC $1E
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $1F
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $14
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $15
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $1C
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $1D
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $16
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $17
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $18
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $19
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $1A
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $1B
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func noinline @g : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}
func @many_calls : (i16, i16, i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16, %2 : i16, %3 : i16):
    %4 : i16 = call.func @g, %0
    %5 : i16 = call.func @g, %1
    %6 : i16 = arith.addi %4, %5
    %7 : i16 = call.func @g, %2
    %8 : i16 = call.func @g, %3
    %9 : i16 = arith.addi %7, %8
    %10 : i16 = arith.addi %6, %9
    %11 : i16 = arith.addi %10, %0
    %12 : i16 = arith.addi %11, %1
    %13 : i16 = arith.addi %12, %2
    %14 : i16 = arith.addi %13, %3
    core.return %14
}
