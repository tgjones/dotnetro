; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "pressure_i16(*, *, *, *)"

; Corpus: llvm-mos-reference/pressure/pressure-i16
;   int pressure_i16(int a, int b, int c, int d) {
;       int t0 = a + b;  int t1 = c + d;  int t2 = a + c;  int t3 = b + d;
;       return (t0 ^ t1) + (t2 ^ t3);
;   }
; Moderate pressure: several i16 temporaries live at once, but few enough to fit
; in the imaginary register file without spilling to the soft stack.

; CHECK: pressure_i16:
; CHECK:     CLC
; CHECK:     TAY
; CHECK:     ADC $02
; CHECK:     STA $14
; CHECK:     TXA
; CHECK:     ADC $03
; CHECK:     CLC
; CHECK:     STA $15
; CHECK:     LDA $04
; CHECK:     ADC $06
; CHECK:     STA $16
; CHECK:     LDA $05
; CHECK:     ADC $07
; CHECK:     CLC
; CHECK:     STA $17
; CHECK:     TYA
; CHECK:     ADC $04
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $05
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     LDA $02
; CHECK:     ADC $06
; CHECK:     STA $18
; CHECK:     LDA $03
; CHECK:     ADC $07
; CHECK:     STA $19
; CHECK:     LDA $14
; CHECK:     EOR $16
; CHECK:     STA $1A
; CHECK:     LDA $15
; CHECK:     EOR $17
; CHECK:     STA $1B
; CHECK:     TYA
; CHECK:     EOR $18
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     EOR $19
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $1A
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $1B
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @pressure_i16 : (i16, i16, i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16, %2 : i16, %3 : i16):
    %4 : i16 = arith.addi %0, %1
    %5 : i16 = arith.addi %2, %3
    %6 : i16 = arith.addi %0, %2
    %7 : i16 = arith.addi %1, %3
    %8 : i16 = arith.xor %4, %5
    %9 : i16 = arith.xor %6, %7
    %10 : i16 = arith.addi %8, %9
    core.return %10
}
