func @pressure_high : (i32, i32, i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32, %2 : i32, %3 : i32):
    %4 : i32 = arith.muli %0, %1
    %5 : i32 = arith.muli %1, %2
    %6 : i32 = arith.muli %2, %3
    %7 : i32 = arith.muli %3, %0
    %8 : i32 = arith.addi %4, %5
    %9 : i32 = arith.addi %6, %7
    %10 : i32 = arith.muli %8, %9
    %11 : i32 = arith.addi %10, %4
    %12 : i32 = arith.addi %11, %5
    %13 : i32 = arith.addi %12, %6
    %14 : i32 = arith.addi %13, %7
    core.return %14
}
