; CHECK:     RTS

func @pressure_i64 : (i64, i64, i64) -> i64 {
bb0(%0 : i64, %1 : i64, %2 : i64):
    %3 : i64 = arith.addi %0, %1
    %4 : i64 = arith.addi %1, %2
    %5 : i64 = arith.addi %0, %2
    %6 : i64 = arith.xor %3, %4
    %7 : i64 = arith.xor %4, %5
    %8 : i64 = arith.xor %3, %5
    %9 : i64 = arith.addi %6, %7
    %10 : i64 = arith.addi %9, %8
    core.return %10
}
