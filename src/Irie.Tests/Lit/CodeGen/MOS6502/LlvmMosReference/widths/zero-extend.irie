; RUN: @iriec --target mos6502 --emit=asm @file

; Corpus: llvm-mos-reference/widths/zero-extend
;   int zero_extend(unsigned char a) { return (int)a + 1; }
; The unsigned char is zero-extended to i16 (the high byte is a constant 0), then 1
; is added.

; CHECK: zero_extend:
; CHECK:     LDX #$00
; CHECK:     CLC
; CHECK:     ADC #$01
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC #$00
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @zero_extend : (i8) -> i16 {
bb0(%0 : i8):
    %1 : i16 = cast.zext %0
    %2 : i16 = arith.constant 1
    %3 : i16 = arith.addi %1, %2
    core.return %3
}
