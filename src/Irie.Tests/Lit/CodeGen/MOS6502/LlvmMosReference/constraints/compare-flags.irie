; CHECK:     CMP $08
; CHECK:     BCC .bb11
; CHECK: .bb1:
; CHECK:     LDA #$00
; CHECK:     STA $04
; CHECK: .bb2:
; CHECK:     LDA $03
; CHECK:     EOR #$80
; CHECK:     TAY
; CHECK:     LDA $05
; CHECK:     EOR #$80
; CHECK:     STA $02
; CHECK:     TYA
; CHECK:     CMP $02
; CHECK:     BCC .bb12
; CHECK:     BNE .bb3
; CHECK:     LDA $08
; CHECK:     CMP $06
; CHECK:     BCC .bb12
; CHECK: .bb3:
; CHECK:     LDA #$00
; CHECK:     STA $02
; CHECK: .bb4:
; CHECK:     LDA $04
; CHECK:     AND $02
; CHECK:     BEQ .bb13
; CHECK: .bb5:
; CHECK:     LDY #$01
; CHECK: .bb6:
; CHECK:     TXA
; CHECK:     CMP $05
; CHECK:     BNE .bb14
; CHECK:     LDA $07
; CHECK:     CMP $06
; CHECK:     BNE .bb14
; CHECK: .bb7:
; CHECK:     LDA #$00
; CHECK:     STA $02
; CHECK: .bb8:
; CHECK:     TYA
; CHECK:     AND $02
; CHECK:     BEQ .bb15
; CHECK: .bb9:
; CHECK:     LDA #$01
; CHECK: .bb10:
; CHECK:     RTS
; CHECK: .bb11:
; CHECK:     LDA #$01
; CHECK:     STA $04
; CHECK:     JMP .bb2
; CHECK: .bb12:
; CHECK:     LDA #$01
; CHECK:     STA $02
; CHECK:     JMP .bb4
; CHECK: .bb13:
; CHECK:     LDY #$00
; CHECK:     JMP .bb6
; CHECK: .bb14:
; CHECK:     LDA #$01
; CHECK:     STA $02
; CHECK:     JMP .bb8
; CHECK: .bb15:
; CHECK:     LDA #$00
; CHECK:     RTS

func @compare_flags : (i16, i16, i16) -> i8 {
bb0(%0 : i16, %1 : i16, %2 : i16):
    %3 : i1 = arith.cmpi slt, %0, %1
    %4 : i1 = arith.cmpi slt, %1, %2
    %5 : i1 = arith.and %3, %4
    %6 : i1 = arith.cmpi ne, %0, %2
    %7 : i1 = arith.and %5, %6
    %8 : i8 = cast.zext %7
    core.return %8
}
