; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "shift_const(*)"

; Corpus: llvm-mos-reference/constraints/shift-const
; (a << 3) | (a >> 2) on a signed i16.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/constraints/shift-const.s; close gaps via irie-report.

; CHECK: shift_const:
; CHECK:     STA $14
; CHECK:     ASL
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ROL
; CHECK:     STA $15
; CHECK:     TYA
; CHECK:     ASL
; CHECK:     TAY
; CHECK:     LDA $15
; CHECK:     ROL
; CHECK:     STA $16
; CHECK:     TYA
; CHECK:     ASL
; CHECK:     STA $17
; CHECK:     LDA $16
; CHECK:     ROL
; CHECK:     CPX #$80
; CHECK:     STA $18
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     LDA $14
; CHECK:     ROR
; CHECK:     CPX #$80
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ROR
; CHECK:     ORA $17
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ORA $18
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @shift_const : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i8 = arith.constant 3
    %2 : i16 = arith.shl %0, %1
    %3 : i8 = arith.constant 2
    %4 : i16 = arith.ashr %0, %3
    %5 : i16 = arith.or %2, %4
    core.return %5
}
