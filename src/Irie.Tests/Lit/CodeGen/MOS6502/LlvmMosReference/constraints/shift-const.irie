; RUN: @iriec --target mos6502 --emit=asm @file

; Corpus: llvm-mos-reference/constraints/shift-const
; (a << 3) | (a >> 2) on a signed i16.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/constraints/shift-const.s; close gaps via irie-report.

; CHECK: shift_const:
; CHECK:     STA $05
; CHECK:     STX $04
; CHECK:     ASL
; CHECK:     TAX
; CHECK:     LDA $04
; CHECK:     ROL
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ASL
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ROL
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ASL
; CHECK:     STA $03
; CHECK:     TYA
; CHECK:     ROL
; CHECK:     STA $02
; CHECK:     LDA $04
; CHECK:     CMP #$80
; CHECK:     ROR
; CHECK:     TAY
; CHECK:     LDA $05
; CHECK:     ROR
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     CMP #$80
; CHECK:     ROR
; CHECK:     STA $04
; CHECK:     TXA
; CHECK:     ROR
; CHECK:     STA $05
; CHECK:     LDA $03
; CHECK:     ORA $05
; CHECK:     TAY
; CHECK:     LDA $02
; CHECK:     ORA $04
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @shift_const : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i8 = arith.constant 3
    %2 : i16 = arith.shl %0, %1
    %3 : i8 = arith.constant 2
    %4 : i16 = arith.ashr %0, %3
    %5 : i16 = arith.or %2, %4
    core.return %5
}
