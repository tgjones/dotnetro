; RUN: @iriec --target mos6502 --emit=asm @file

; Corpus: llvm-mos-reference/constraints/shift-var
; a << n with a variable count (the count truncated to the helper's i8).
; 
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/constraints/shift-var.s; close gaps via irie-report.

; CHECK: shift_var:

func @shift_var : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i8 = cast.trunc %1
    %3 : i16 = arith.shl %0, %2
    core.return %3
}
