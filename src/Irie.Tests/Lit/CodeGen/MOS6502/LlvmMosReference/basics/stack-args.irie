; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "stack_args(*, *, *, *, *, *, *, *, *, *)"

; Corpus: llvm-mos-reference/basics/stack-args
; Ten i16 args (20 bytes) overflow the 16-byte CC_MOS register budget ($a, $x,
; $zp2..$zp15): the last two params (i, j) arrive as caller-placed stack
; arguments, addressed directly off the live RC0/RC1 soft stack pointer
; (MOS6502CallLowering.LowerFormalArguments / MOS6502FrameLowering
; .LowerCallerStackArgAccess) rather than through a materialized pointer pair.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/basics/stack-args.s; close gaps via irie-report.

; CHECK: stack_args:
; CHECK:     STA $16
; CHECK:     LDA $02
; CHECK:     STA $15
; CHECK:     LDA $03
; CHECK:     STA $14
; CHECK:     LDA $04
; CHECK:     STA $11
; CHECK:     LDA $05
; CHECK:     STA $10
; CHECK:     LDY #$00
; CHECK:     LDA ($00),Y
; CHECK:     STA $05
; CHECK:     LDY #$01
; CHECK:     LDA ($00),Y
; CHECK:     STA $04
; CHECK:     LDY #$02
; CHECK:     LDA ($00),Y
; CHECK:     STA $03
; CHECK:     LDY #$03
; CHECK:     LDA ($00),Y
; CHECK:     STA $02
; CHECK:     CLC
; CHECK:     LDA $16
; CHECK:     ADC $15
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $14
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $11
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $10
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $06
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $07
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $08
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $09
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $0A
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $0B
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $0C
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $0D
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $0E
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $0F
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $05
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $04
; CHECK:     TAX
; CHECK:     CLC
; CHECK:     TYA
; CHECK:     ADC $03
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $02
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @stack_args : (i16, i16, i16, i16, i16, i16, i16, i16, i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16, %2 : i16, %3 : i16, %4 : i16, %5 : i16, %6 : i16, %7 : i16, %8 : i16, %9 : i16):
    %10 : i16 = arith.addi %0, %1
    %11 : i16 = arith.addi %10, %2
    %12 : i16 = arith.addi %11, %3
    %13 : i16 = arith.addi %12, %4
    %14 : i16 = arith.addi %13, %5
    %15 : i16 = arith.addi %14, %6
    %16 : i16 = arith.addi %15, %7
    %17 : i16 = arith.addi %16, %8
    %18 : i16 = arith.addi %17, %9
    core.return %18
}
