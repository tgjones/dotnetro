; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "select_val(*, *, *)"

; Corpus: llvm-mos-reference/control-flow/select
; cond ? a : b as a diamond with a merge-block phi (same MIR shape as
; coalescing/redundant-copy). Exercises block-parameter edge moves +
; cross-block placement.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/control-flow/select.s; close gaps via irie-report.

; CHECK: select_val:
; CHECK:     CPX #$00
; CHECK:     BNE .bb3
; CHECK:     TAX
; CHECK:     BNE .bb3
; CHECK: .bb1:
; CHECK:     LDX $05
; CHECK:     LDY $04
; CHECK: .bb2:
; CHECK:     TYA
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDY $02
; CHECK:     LDX $03

func @select_val : (i16, i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16, %2 : i16):
    %3 : i16 = arith.constant 0
    %4 : i1 = arith.cmpi ne, %0, %3
    cf.cond_br %4, bb1(), bb2()
bb1():
    cf.br bb3(%1)
bb2():
    cf.br bb3(%2)
bb3(%5 : i16):
    core.return %5
}
