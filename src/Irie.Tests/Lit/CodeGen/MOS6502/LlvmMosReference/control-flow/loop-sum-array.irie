; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "loop_sum_array(buf(32), 0..16)"

; Corpus: llvm-mos-reference/control-flow/loop-sum-array
; s += a[i] over i < n, i16 elements.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/control-flow/loop-sum-array.s; close gaps via irie-report.

; CHECK: loop_sum_array:
; CHECK:     LDY #$00
; CHECK:     STA $19
; CHECK:     STX $1A
; CHECK:     STY $14
; CHECK:     STY $16
; CHECK:     STY $17
; CHECK: .bb1:
; CHECK:     LDA $14
; CHECK:     EOR #$80
; CHECK:     TAX
; CHECK:     LDA $03
; CHECK:     EOR #$80
; CHECK:     STA $18
; CHECK:     STY $15
; CHECK:     CPX $18
; CHECK:     BCC .bb3
; CHECK:     BNE .bb2
; CHECK:     CPY $02
; CHECK:     BCC .bb3
; CHECK: .bb2:
; CHECK:     LDX $17
; CHECK:     LDA $16
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDA $15
; CHECK:     ASL
; CHECK:     TAX
; CHECK:     LDA $14
; CHECK:     ROL
; CHECK:     CLC
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $19
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $1A
; CHECK:     STX $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     STA $18
; CHECK:     LDA ($12),Y
; CHECK:     LDY #$01
; CHECK:     STA $18
; CHECK:     LDA ($12),Y
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     LDA $16
; CHECK:     ADC $18
; CHECK:     STA $16
; CHECK:     TXA
; CHECK:     ADC $17
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $15
; CHECK:     TAY
; CHECK:     LDA $14
; CHECK:     ADC #$00
; CHECK:     STA $14
; CHECK:     STX $17
; CHECK:     JMP .bb1

func @loop_sum_array : (ptr, i16) -> i16 {
bb0(%0 : ptr, %1 : i16):
    %2 : i16 = arith.constant 0
    cf.br bb1(%2, %2)
bb1(%3 : i16, %4 : i16):
    %5 : i1 = arith.cmpi slt, %3, %1
    cf.cond_br %5, bb2(%3, %4), bb3(%4)
bb2(%6 : i16, %7 : i16):
    %8 : i8 = arith.constant 1
    %9 : i16 = arith.shl %6, %8
    %10 : ptr = mem.ptradd %0, %9
    %11 : i16 = mem.load.i16 %10
    %12 : i16 = arith.addi %7, %11
    %13 : i16 = arith.constant 1
    %14 : i16 = arith.addi %6, %13
    cf.br bb1(%14, %12)
bb3(%15 : i16):
    core.return %15
}
