; RUN: @iriec --target mos6502 --emit=asm @file

; Corpus: llvm-mos-reference/control-flow/loop-sum-array
; s += a[i] over i < n, i16 elements.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/control-flow/loop-sum-array.s; close gaps via irie-report.

; CHECK: loop_sum_array:
; CHECK:     STA $04
; CHECK:     LDA #$00
; CHECK:     STA $0A
; CHECK:     LDA #$00
; CHECK:     STA $09
; CHECK:     LDA $0A
; CHECK:     STA $08
; CHECK:     LDA $09
; CHECK:     STA $07
; CHECK: .bb1:
; CHECK:     LDA $07
; CHECK:     EOR #$80
; CHECK:     TAY
; CHECK:     LDA $03
; CHECK:     EOR #$80
; CHECK:     STA $05
; CHECK:     TYA
; CHECK:     CMP $05
; CHECK:     BCC .bb4
; CHECK:     BNE .bb5
; CHECK:     LDA $08
; CHECK:     CMP $02
; CHECK:     BCC .bb4
; CHECK: .bb2:
; CHECK:     LDA $0A
; CHECK:     LDX $09
; CHECK: .bb3:
; CHECK:     RTS
; CHECK: .bb4:
; CHECK:     LDA $08
; CHECK:     ASL
; CHECK:     STA $06
; CHECK:     LDA $07
; CHECK:     ROL
; CHECK:     STA $05
; CHECK:     CLC
; CHECK:     LDA $04
; CHECK:     ADC $06
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $05
; CHECK:     STY $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     LDA ($12),Y
; CHECK:     STA $06
; CHECK:     LDY #$01
; CHECK:     LDA ($12),Y
; CHECK:     STA $05
; CHECK:     CLC
; CHECK:     LDA $0A
; CHECK:     ADC $06
; CHECK:     STA $0A
; CHECK:     LDA $09
; CHECK:     ADC $05
; CHECK:     STA $09
; CHECK:     CLC
; CHECK:     LDA $08
; CHECK:     ADC #$01
; CHECK:     STA $08
; CHECK:     LDA $07
; CHECK:     ADC #$00
; CHECK:     STA $07
; CHECK:     JMP .bb1
; CHECK: .bb5:
; CHECK:     LDA $0A
; CHECK:     LDX $09
; CHECK:     RTS

func @loop_sum_array : (ptr, i16) -> i16 {
bb0(%0 : ptr, %1 : i16):
    %2 : i16 = arith.constant 0
    cf.br bb1(%2, %2)
bb1(%3 : i16, %4 : i16):
    %5 : i1 = arith.cmpi slt, %3, %1
    cf.cond_br %5, bb2(%3, %4), bb3(%4)
bb2(%6 : i16, %7 : i16):
    %8 : i8 = arith.constant 1
    %9 : i16 = arith.shl %6, %8
    %10 : ptr = mem.ptradd %0, %9
    %11 : i16 = mem.load.i16 %10
    %12 : i16 = arith.addi %7, %11
    %13 : i16 = arith.constant 1
    %14 : i16 = arith.addi %6, %13
    cf.br bb1(%14, %12)
bb3(%15 : i16):
    core.return %15
}
