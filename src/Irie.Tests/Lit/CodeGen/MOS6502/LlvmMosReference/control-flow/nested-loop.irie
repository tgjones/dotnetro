; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "nested_loop(0..6, 0..6)"

; Corpus: llvm-mos-reference/control-flow/nested-loop
; s += i * j over nested loops i < n, j < m.
;
; CHECK pins Irie's current --emit=asm output (characterization / golden).
; Compare against ext/llvm-mos-reference/control-flow/nested-loop.s; close gaps via irie-report.

; CHECK: nested_loop:
; CHECK:     LDY #$00
; CHECK:     STA $1D
; CHECK:     STX $1E
; CHECK:     LDX $02
; CHECK:     STX $1B
; CHECK:     LDX $03
; CHECK:     STX $1C
; CHECK:     STY $1A
; CHECK:     STY $16
; CHECK:     STY $17
; CHECK: .bb1:
; CHECK:     LDA $1A
; CHECK:     EOR #$80
; CHECK:     TAX
; CHECK:     LDA $1E
; CHECK:     EOR #$80
; CHECK:     STA $14
; CHECK:     STY $19
; CHECK:     CPX $14
; CHECK:     BCC .bb3
; CHECK:     BNE .bb2
; CHECK:     CPY $1D
; CHECK:     BCC .bb3
; CHECK: .bb2:
; CHECK:     LDX $17
; CHECK:     LDA $16
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDY #$00
; CHECK:     STY $14
; CHECK:     STY $15
; CHECK: .bb4:
; CHECK:     LDA $15
; CHECK:     EOR #$80
; CHECK:     TAX
; CHECK:     LDA $1C
; CHECK:     EOR #$80
; CHECK:     STA $18
; CHECK:     CPX $18
; CHECK:     BCC .bb6
; CHECK:     BNE .bb5
; CHECK:     LDA $14
; CHECK:     CMP $1B
; CHECK:     BCC .bb6
; CHECK: .bb5:
; CHECK:     CLC
; CHECK:     LDA $19
; CHECK:     ADC #$01
; CHECK:     STA $19
; CHECK:     LDA $1A
; CHECK:     ADC #$00
; CHECK:     STA $1A
; CHECK:     LDY $19
; CHECK:     JMP .bb1
; CHECK: .bb6:
; CHECK:     LDY $14
; CHECK:     STY $02
; CHECK:     LDX $15
; CHECK:     STX $03
; CHECK:     LDX $1A
; CHECK:     LDA $19
; CHECK:     JSR __mulhi3
; CHECK:     CLC
; CHECK:     ADC $16
; CHECK:     STA $16
; CHECK:     TXA
; CHECK:     ADC $17
; CHECK:     CLC
; CHECK:     STA $17
; CHECK:     LDA $14
; CHECK:     ADC #$01
; CHECK:     STA $14
; CHECK:     LDA $15
; CHECK:     ADC #$00

func @nested_loop : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i16 = arith.constant 0
    cf.br bb1(%2, %2)
bb1(%3 : i16, %4 : i16):
    %5 : i1 = arith.cmpi slt, %3, %0
    cf.cond_br %5, bb2(%3, %4), bb5(%4)
bb2(%6 : i16, %7 : i16):
    %8 : i16 = arith.constant 0
    cf.br bb3(%6, %7, %8)
bb3(%9 : i16, %10 : i16, %11 : i16):
    %12 : i1 = arith.cmpi slt, %11, %1
    cf.cond_br %12, bb4(%9, %10, %11), bb6(%9, %10)
bb4(%13 : i16, %14 : i16, %15 : i16):
    %16 : i16 = arith.muli %13, %15
    %17 : i16 = arith.addi %14, %16
    %18 : i16 = arith.constant 1
    %19 : i16 = arith.addi %15, %18
    cf.br bb3(%13, %17, %19)
bb6(%20 : i16, %21 : i16):
    %22 : i16 = arith.constant 1
    %23 : i16 = arith.addi %20, %22
    cf.br bb1(%23, %21)
bb5(%24 : i16):
    core.return %24
}
