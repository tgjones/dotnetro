; RUN: @iriec --target mos6502 --emit=asm @file

; Multiply, divide and remainder have no 6502 instruction. The legalizer turns
; each into a call to a runtime helper (compiler-rt names): i16 multiply is
; __mulhi3, i32 multiply __mulsi3, i32 divide / remainder __udivsi3 / __divsi3 /
; __umodsi3 / __modsi3. Narrower operands are widened to the helper's width
; (zero-extend for multiply and the unsigned forms, sign-extend for the signed
; forms) and the result truncated back.

; CHECK: Mul16:
; CHECK:     JMP __mulhi3
; CHECK:
; CHECK: Mul32:
; CHECK:     JMP __mulsi3
; CHECK:
; CHECK: Mul8:
; CHECK:     STX $02
; CHECK:     LDY #$00
; CHECK:     STY $03
; CHECK:     LDX #$00
; CHECK:     JMP __mulhi3
; CHECK:
; CHECK: UDiv32:
; CHECK:     JMP __udivsi3
; CHECK:
; CHECK: SDiv32:
; CHECK:     JMP __divsi3
; CHECK:
; CHECK: URem32:
; CHECK:     JMP __umodsi3
; CHECK:
; CHECK: SRem32:
; CHECK:     JMP __modsi3
; CHECK:
; CHECK: SDiv8:
; CHECK:     CMP #$00
; CHECK:     BMI .bb5
; CHECK: .bb1:
; CHECK:     LDY #$00
; CHECK: .bb2:
; CHECK:     STA $14
; CHECK:     TXA
; CHECK:     BMI .bb6
; CHECK: .bb3:
; CHECK:     LDX #$00
; CHECK:     STX $15
; CHECK: .bb4:
; CHECK:     STY $02
; CHECK:     STY $03
; CHECK:     STA $04
; CHECK:     LDX $15
; CHECK:     STX $05
; CHECK:     STX $06
; CHECK:     STX $07
; CHECK:     STY $16
; CHECK:     LDX $16
; CHECK:     LDA $14
; CHECK:     JMP __divsi3
; CHECK: .bb5:
; CHECK:     LDY #$FF
; CHECK:     JMP .bb2
; CHECK: .bb6:
; CHECK:     LDX #$FF
; CHECK:     STX $15
; CHECK:     JMP .bb4

func @Mul16 : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i16 = arith.muli %0, %1
    core.return %2
}

func @Mul32 : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.muli %0, %1
    core.return %2
}

func @Mul8 : (i8, i8) -> i8 {
bb0(%0 : i8, %1 : i8):
    %2 : i8 = arith.muli %0, %1
    core.return %2
}

func @UDiv32 : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.udivi %0, %1
    core.return %2
}

func @SDiv32 : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.sdivi %0, %1
    core.return %2
}

func @URem32 : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.uremi %0, %1
    core.return %2
}

func @SRem32 : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.sremi %0, %1
    core.return %2
}

func @SDiv8 : (i8, i8) -> i8 {
bb0(%0 : i8, %1 : i8):
    %2 : i8 = arith.sdivi %0, %1
    core.return %2
}
