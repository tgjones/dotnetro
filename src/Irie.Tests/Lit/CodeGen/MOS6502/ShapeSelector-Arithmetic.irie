; RUN: @iriec --target mos6502 --placement naive --stop-after InstructionSelector @file

; Shape selection: the legalized generic MIR becomes the
; unpinned byte operations of the mos6502 dialect. A multi-byte add is a chain of
; `mos6502.adc` (carry out of one is the carry in of the next, a head with a
; constant carry in), a shift left a chain of `shle`, and the sign seed of an
; arithmetic shift right the carry a compare leaves, `mos6502.cmp`. Nothing names
; a register, a register class or an addressing mode; constants are `const`.

; CHECK: func @arith : (i16, i16) -> i16 {
; CHECK: bb0():
; CHECK:     [liveins: $a, $x, $zp2, $zp3]
; CHECK:     %11 : i8 = pseudo.copy $a
; CHECK:     %12 : i8 = pseudo.copy $x
; CHECK:     %13 : i8 = pseudo.copy $zp2
; CHECK:     %14 : i8 = pseudo.copy $zp3
; CHECK:     %70 : i1 = mos6502.const 0
; CHECK:     %71 : i8, %72 : i1 = mos6502.adc %11, %13, %70
; CHECK:     %73 : i8, %74 : i1 = mos6502.adc %12, %14, %72
; CHECK:     %61 : i1 = mos6502.const 1
; CHECK:     %62 : i8, %63 : i1 = mos6502.sbc %71, %13, %61
; CHECK:     %64 : i8, %65 : i1 = mos6502.sbc %73, %14, %63
; CHECK:     %55 : i8 = mos6502.and %62, %11
; CHECK:     %56 : i8 = mos6502.and %64, %12
; CHECK:     %49 : i8 = mos6502.ora %55, %13
; CHECK:     %50 : i8 = mos6502.ora %56, %14
; CHECK:     %43 : i8 = mos6502.eor %49, %11
; CHECK:     %44 : i8 = mos6502.eor %50, %12
; CHECK:     %29 : i1 = mos6502.const 0
; CHECK:     %30 : i8, %31 : i1 = mos6502.shle %43, %29
; CHECK:     %32 : i8, %33 : i1 = mos6502.shle %44, %31
; CHECK:     %34 : i1 = mos6502.const 0
; CHECK:     %35 : i8, %36 : i1 = mos6502.shle %30, %34
; CHECK:     %37 : i8, %38 : i1 = mos6502.shle %32, %36
; CHECK:     %20 : i8 = mos6502.const 128
; CHECK:     %21 : i1 = mos6502.cmp %37, %20
; CHECK:     %22 : i8, %23 : i1 = mos6502.lshre %37, %21
; CHECK:     %24 : i8, %25 : i1 = mos6502.lshre %35, %23
; CHECK:     $a = pseudo.copy %24
; CHECK:     $x = pseudo.copy %22
; CHECK:     mos6502.rts implicit $a, implicit $x
; CHECK: }

func @arith : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i16 = arith.addi %0, %1
    %3 : i16 = arith.subi %2, %1
    %4 : i16 = arith.and %3, %0
    %5 : i16 = arith.or %4, %1
    %6 : i16 = arith.xor %5, %0
    %7 : i8 = arith.constant 2
    %8 : i16 = arith.shl %6, %7
    %9 : i8 = arith.constant 1
    %10 : i16 = arith.ashr %8, %9
    core.return %10
}
