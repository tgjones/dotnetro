; RUN: @iriec --target mos6502 --emit=asm @file

; Verifies the cross-call model. %0 is live across the first call (it is the arg to
; the second call), so the RA must NOT keep it in a caller-saved physreg.
; MOS6502CallLowering marks $a, $x, $y, the flag regs (except D/I) and RC2..RC19 as
; clobbered on every jsr.abs, so %0 lands in a home: a function-local zero-page
; byte that no call clobbers, because program layout keeps a function's homes
; above those of all its callees. Nothing is saved or restored, and the final call
; becomes a tail call.

; CHECK: TestCrossCall:
; CHECK:     STA $14
; CHECK:     JSR Callee
; CHECK:     LDA $14
; CHECK:     JMP Callee

func @TestCrossCall : (i8) -> i8 {
bb0(%0 : i8):
    %1 : i8 = call.func @Callee, %0
    %2 : i8 = call.func @Callee, %0
    core.return %2
}
