; RUN: @iriec --target mos6502 --emit=bin --origin=0x1900 @file | @irie-mc --hex-dump

; End-to-end: an i32 constant flows through the full pipeline (legalizer,
; shape selection, placement, pseudo expansion, encoder). The legalizer narrows the
; wide `arith.constant 42 : i32` into 4 byte-sized constants (42, 0, 0, 0
; LSB-first). The placement builds each byte in the register it is returned in:
; byte 0 in A, byte 1 in X, bytes 2 and 3 in $02 and $03. The three zero bytes
; share one load of #0 (into Y, which is free), stored to $02 and $03 and
; transferred into X by a second load; A gets 42 last.
;
;   LDY #$00            ; A0 00
;   STY $02             ; 84 02       ; byte 2
;   STY $03             ; 84 03       ; byte 3
;   LDX #$00            ; A2 00       ; byte 1
;   LDA #$2A            ; A9 2A       ; byte 0 = 42
;   RTS                 ; 60

; CHECK: 00000000: A0 00 84 02 84 03 A2 00  A9 2A 60

func @TestConstant : () -> i32 {
bb0():
    %0 : i32 = arith.constant 42
    core.return %0
}
