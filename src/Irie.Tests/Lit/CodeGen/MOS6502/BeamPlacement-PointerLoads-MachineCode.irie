; RUN: @iriec --target mos6502 --placement beam --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --placement beam --exec "array_index(buf(32), 0..14)"

; Loads through a pointer pair: the pair $12/$13 is set up from the registers that hold
; the pointer bytes, and the offset goes in Y.

; CHECK: array_index:
; CHECK:     STA $14
; CHECK:     LDA $02
; CHECK:     ASL
; CHECK:     TAY
; CHECK:     LDA $03
; CHECK:     ROL
; CHECK:     CLC
; CHECK:     STA $15
; CHECK:     TYA
; CHECK:     ADC $14
; CHECK:     STX $16
; CHECK:     TAX
; CHECK:     LDA $15
; CHECK:     ADC $16
; CHECK:     STX $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     STA $17
; CHECK:     LDA ($12),Y
; CHECK:     LDY #$01
; CHECK:     STA $18
; CHECK:     LDA ($12),Y
; CHECK:     CLC
; CHECK:     STA $19
; CHECK:     TYA
; CHECK:     ADC $02
; CHECK:     TAX
; CHECK:     LDA $03
; CHECK:     ADC #$00
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ASL
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ROL
; CHECK:     CLC
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $14
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     ADC $16
; CHECK:     STX $12
; CHECK:     STA $13
; CHECK:     LDY #$00
; CHECK:     STA $1A
; CHECK:     LDA ($12),Y
; CHECK:     LDY #$01
; CHECK:     STA $1B
; CHECK:     LDA ($12),Y
; CHECK:     CLC
; CHECK:     TAX
; CHECK:     LDA $18
; CHECK:     ADC $1B
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $19
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @array_index : (ptr, i16) -> i16 {
bb0(%0 : ptr, %1 : i16):
    %2 : i8 = arith.constant 1
    %3 : i16 = arith.shl %1, %2
    %4 : ptr = mem.ptradd %0, %3
    %5 : i16 = mem.load.i16 %4
    %6 : i16 = arith.constant 1
    %7 : i16 = arith.addi %1, %6
    %8 : i16 = arith.shl %7, %2
    %9 : ptr = mem.ptradd %0, %8
    %10 : i16 = mem.load.i16 %9
    %11 : i16 = arith.addi %5, %10
    core.return %11
}
