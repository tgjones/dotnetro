; RUN: @iriec --target mos6502 --emit=asm @file

; A multi-byte call-argument setup.
;
; CC_MOS passes a 32-bit value LSB-first in $a, $x, $zp2($02), $zp3($03). The
; placement builds each byte of 0x12345678 in the register it is passed in
; (immediate loads, stores for the two zero-page bytes), so there is no shuffle
; between homes, and byte 0 (0x78) reaches $a intact at the JMP.

; CHECK: SinkI32:
; CHECK:     RTS
; CHECK:
; CHECK: CallI32:
; CHECK:     LDY #$34
; CHECK:     STY $02
; CHECK:     LDX #$12
; CHECK:     STX $03
; CHECK:     LDX #$56
; CHECK:     LDA #$78
; CHECK:     JMP SinkI32
; Byte 0 is loaded into $a last, just before the call.

func @SinkI32 : (i32) -> void {
bb0(%0 : i32):
    core.return
}

func @CallI32 : () -> void {
bb0():
    %0 : i32 = arith.constant 305419896
    call.func @SinkI32, %0
    core.return
}
