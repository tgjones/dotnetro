; RUN: @iriec --target mos6502 --placement naive --stop-after InstructionSelector @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --placement beam --exec "step(*, *)"

; A byte add or subtract of one (also written as a subtract or add of 0xFF) is
; `mos6502.inc` / `mos6502.dec`, not an `adc` / `sbc` with a constant carry: the 6502
; has INX, INY and INC for it, and a placement chooses among them. A step of two is
; still an `adc`.

; CHECK: func @step : (i8, i8) -> i8 {
; CHECK: bb0():
; CHECK:     [liveins: $a, $x]
; CHECK:     %0 : i8 = pseudo.copy $a
; CHECK:     %1 : i8 = pseudo.copy $x
; CHECK:     %2 : i8 = mos6502.const 1
; CHECK:     %3 : i8 = mos6502.inc %0
; CHECK:     %4 : i8 = mos6502.dec %1
; CHECK:     %5 : i8 = mos6502.eor %3, %4
; CHECK:     %6 : i8 = mos6502.const 255
; CHECK:     %7 : i8 = mos6502.dec %5
; CHECK:     %8 : i8 = mos6502.const 2
; CHECK:     %10 : i1 = mos6502.const 0
; CHECK:     %9 : i8, %11 : i1 = mos6502.adc %7, %8, %10
; CHECK:     $a = pseudo.copy %9
; CHECK:     mos6502.rts implicit $a
; CHECK: }

func @step : (i8, i8) -> i8 {
bb0(%0 : i8, %1 : i8):
    %2 : i8 = arith.constant 1
    %3 : i8 = arith.addi %0, %2
    %4 : i8 = arith.subi %1, %2
    %5 : i8 = arith.xor %3, %4
    %6 : i8 = arith.constant 255
    %7 : i8 = arith.addi %5, %6
    %8 : i8 = arith.constant 2
    %9 : i8 = arith.addi %7, %8
    core.return %9
}
