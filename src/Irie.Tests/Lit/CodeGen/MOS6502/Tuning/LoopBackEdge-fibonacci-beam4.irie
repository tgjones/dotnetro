; RUN: @iriec --target mos6502 --emit=asm --tune beam=4 @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --tune beam=4 --emulator @emulator --exec "fibonacci(0..24)"

; A loop whose header takes the registers of the edge from outside, placed with --tune beam=4:
; the back edge reconciles to them even where its arguments overwrite the homes
; the header expects in registers.

; CHECK: fibonacci:
; CHECK:     LDY #$00
; CHECK:     STA $1C
; CHECK:     STX $1D
; CHECK:     STY $19
; CHECK:     LDX #$01
; CHECK:     STX $14
; CHECK:     STY $15
; CHECK:     STY $16
; CHECK:     STY $17
; CHECK: .bb1:
; CHECK:     LDA $17
; CHECK:     EOR #$80
; CHECK:     TAX
; CHECK:     LDA $1D
; CHECK:     EOR #$80
; CHECK:     STA $1A
; CHECK:     STY $18
; CHECK:     CPX $1A
; CHECK:     BCC .bb3
; CHECK:     BNE .bb2
; CHECK:     LDA $16
; CHECK:     CMP $1C
; CHECK:     BCC .bb3
; CHECK: .bb2:
; CHECK:     LDX $19
; CHECK:     LDA $18
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     CLC
; CHECK:     LDA $18
; CHECK:     ADC $14
; CHECK:     TAX
; CHECK:     LDA $19
; CHECK:     ADC $15
; CHECK:     CLC
; CHECK:     STA $18
; CHECK:     LDA $16
; CHECK:     ADC #$01
; CHECK:     STA $16
; CHECK:     LDA $17
; CHECK:     ADC #$00
; CHECK:     STX $19
; CHECK:     STA $17
; CHECK:     LDY $14
; CHECK:     LDA $14
; CHECK:     STA $14
; CHECK:     LDA $15
; CHECK:     STA $15
; CHECK:     LDA $19
; CHECK:     STA $1A
; CHECK:     LDA $18
; CHECK:     STA $1B
; CHECK:     LDA $14
; CHECK:     STA $18
; CHECK:     LDA $15
; CHECK:     STA $19
; CHECK:     LDA $1A
; CHECK:     STA $14
; CHECK:     LDA $1B
; CHECK:     STA $15
; CHECK:     JMP .bb1


func @fibonacci : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 0
    %2 : i16 = arith.constant 1
    %3 : i16 = arith.constant 0
    cf.br bb1(%1, %2, %3)
bb1(%4 : i16, %5 : i16, %6 : i16):
    %7 : i1 = arith.cmpi slt, %6, %0
    cf.cond_br %7, bb2(), bb3()
bb2():
    %8 : i16 = arith.addi %4, %5
    %9 : i16 = arith.constant 1
    %10 : i16 = arith.addi %6, %9
    cf.br bb1(%5, %8, %10)
bb3():
    core.return %4
}
