; RUN: @iriec --target mos6502 --emit=asm @file

; mem.load.i64 / mem.store.i64 through a mem.symbol address: the Custom
; legalizer rewrites each into eight per-byte mem.load.byte_at /
; mem.store.byte_at ops at offsets 0..7, which isel selects as absolute accesses.

; CHECK: TestMemI64:
; CHECK:     LDA value
; CHECK:     LDX value+1
; CHECK:     LDY value+2
; CHECK:     STA $14
; CHECK:     LDA value+3
; CHECK:     STA $15
; CHECK:     LDA value+4
; CHECK:     STA $16
; CHECK:     LDA value+5
; CHECK:     STA $17
; CHECK:     LDA value+6
; CHECK:     STA $18
; CHECK:     LDA value+7
; CHECK:     STA $19
; CHECK:     LDA $14
; CHECK:     STA value
; CHECK:     STX value+1
; CHECK:     STY value+2
; CHECK:     LDA $15
; CHECK:     STA value+3
; CHECK:     LDA $16
; CHECK:     STA value+4
; CHECK:     LDA $17
; CHECK:     STA value+5
; CHECK:     LDA $18
; CHECK:     STA value+6
; CHECK:     LDA $19
; CHECK:     STA value+7
; CHECK:     RTS

global @value : i64

func @TestMemI64 : () -> void {
bb0():
    %0 : ptr = mem.symbol @value
    %1 : i64 = mem.load.i64 %0
    mem.store.i64 %0, %1
    core.return
}
