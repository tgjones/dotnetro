; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "fibonacci(0..12)"

; The beam placement: the back edge of a loop shifts values between the loop's
; parameters (a, b, i) <- (b, a + b, i + 1). Each move reads a home that another move
; writes, so the moves run in an order that reads before it writes, with the sum held in
; registers meanwhile, instead of copying everything through temporary homes.

; CHECK: fibonacci:
; CHECK:     STA $1B
; CHECK:     STX $1C
; CHECK:     LDY #$00
; CHECK:     STY $18
; CHECK:     STY $19
; CHECK:     LDX #$01
; CHECK:     STX $14
; CHECK:     STY $15
; CHECK:     STY $16
; CHECK:     STY $17
; CHECK: .bb1:
; CHECK:     LDA $17
; CHECK:     EOR #$80
; CHECK:     TAX
; CHECK:     LDA $1C
; CHECK:     EOR #$80
; CHECK:     STA $1A
; CHECK:     CPX $1A
; CHECK:     BCC .bb3
; CHECK:     BNE .bb2
; CHECK:     LDA $16
; CHECK:     CMP $1B
; CHECK:     BCC .bb3
; CHECK: .bb2:
; CHECK:     LDX $19
; CHECK:     LDA $18
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     CLC
; CHECK:     LDA $18
; CHECK:     ADC $14
; CHECK:     TAX
; CHECK:     LDA $19
; CHECK:     ADC $15
; CHECK:     CLC
; CHECK:     TAY
; CHECK:     LDA $16
; CHECK:     ADC #$01
; CHECK:     STA $16
; CHECK:     LDA $17
; CHECK:     ADC #$00
; CHECK:     STA $17
; CHECK:     LDA $14
; CHECK:     STA $18
; CHECK:     STX $14
; CHECK:     LDA $15
; CHECK:     STA $19
; CHECK:     STY $15
; CHECK:     JMP .bb1

func @fibonacci : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 0
    %2 : i16 = arith.constant 1
    %3 : i16 = arith.constant 0
    cf.br bb1(%1, %2, %3)
bb1(%4 : i16, %5 : i16, %6 : i16):
    %7 : i1 = arith.cmpi slt, %6, %0
    cf.cond_br %7, bb2(), bb3()
bb2():
    %8 : i16 = arith.addi %4, %5
    %9 : i16 = arith.constant 1
    %10 : i16 = arith.addi %6, %9
    cf.br bb1(%5, %8, %10)
bb3():
    core.return %4
}
