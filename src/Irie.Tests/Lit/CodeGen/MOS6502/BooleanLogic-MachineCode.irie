; RUN: @iriec --target mos6502 --emit=asm @file

; and/or/xor of i1 values run on their materialized 0/1 bytes and
; cast.zext/sext from i1 select 1 (or -1) / 0.

; CHECK: AndBool:
; CHECK:     CPX $03
; CHECK:     BNE .bb7
; CHECK:     CMP $02
; CHECK:     BNE .bb7
; CHECK: .bb1:
; CHECK:     LDX #$01
; CHECK: .bb2:
; CHECK:     LDA $03
; CHECK:     STX $14
; CHECK:     CMP $05
; CHECK:     BNE .bb8
; CHECK:     LDA $02
; CHECK:     CMP $04
; CHECK:     BNE .bb8
; CHECK: .bb3:
; CHECK:     LDX #$01
; CHECK: .bb4:
; CHECK:     TXA
; CHECK:     AND $14
; CHECK:     BNE .bb9
; CHECK: .bb5:
; CHECK:     LDX #$00
; CHECK: .bb6:
; CHECK:     TXA
; CHECK:     RTS
; CHECK: .bb7:
; CHECK:     LDX #$00
; CHECK:     JMP .bb2
; CHECK: .bb8:
; CHECK:     LDX #$00
; CHECK:     JMP .bb4
; CHECK: .bb9:
; CHECK:     LDX #$01
; CHECK:     JMP .bb6
; CHECK:
; CHECK: OrBool:
; CHECK:     CPX $03
; CHECK:     BNE .bb7
; CHECK:     CMP $02
; CHECK:     BNE .bb7
; CHECK: .bb1:
; CHECK:     LDX #$01
; CHECK: .bb2:
; CHECK:     LDA $03
; CHECK:     STX $14
; CHECK:     CMP $05
; CHECK:     BNE .bb8
; CHECK:     LDA $02
; CHECK:     CMP $04
; CHECK:     BNE .bb8
; CHECK: .bb3:
; CHECK:     LDX #$01
; CHECK: .bb4:
; CHECK:     TXA
; CHECK:     ORA $14
; CHECK:     BNE .bb9
; CHECK: .bb5:
; CHECK:     LDX #$00
; CHECK: .bb6:
; CHECK:     TXA
; CHECK:     RTS
; CHECK: .bb7:
; CHECK:     LDX #$00
; CHECK:     JMP .bb2
; CHECK: .bb8:
; CHECK:     LDX #$00
; CHECK:     JMP .bb4
; CHECK: .bb9:
; CHECK:     LDX #$01
; CHECK:     JMP .bb6
; CHECK:
; CHECK: XorBool:
; CHECK:     CPX $03
; CHECK:     BNE .bb7
; CHECK:     CMP $02
; CHECK:     BNE .bb7
; CHECK: .bb1:
; CHECK:     LDX #$01
; CHECK: .bb2:
; CHECK:     LDA $03
; CHECK:     STX $14
; CHECK:     CMP $05
; CHECK:     BNE .bb8
; CHECK:     LDA $02
; CHECK:     CMP $04
; CHECK:     BNE .bb8
; CHECK: .bb3:
; CHECK:     LDX #$01
; CHECK: .bb4:
; CHECK:     TXA
; CHECK:     EOR $14
; CHECK:     BNE .bb9
; CHECK: .bb5:
; CHECK:     LDX #$00
; CHECK: .bb6:
; CHECK:     TXA
; CHECK:     RTS
; CHECK: .bb7:
; CHECK:     LDX #$00
; CHECK:     JMP .bb2
; CHECK: .bb8:
; CHECK:     LDX #$00
; CHECK:     JMP .bb4
; CHECK: .bb9:
; CHECK:     LDX #$01
; CHECK:     JMP .bb6
; CHECK:
; CHECK: ZextBool16:
; CHECK:     CPX $03
; CHECK:     BCC .bb1
; CHECK:     BNE .bb3
; CHECK:     CMP $02
; CHECK:     BCS .bb3
; CHECK: .bb1:
; CHECK:     LDX #$01
; CHECK: .bb2:
; CHECK:     TXA
; CHECK:     LDX #$00
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDX #$00
; CHECK:     JMP .bb2
; CHECK:
; CHECK: SextBool32:
; CHECK:     CPX $03
; CHECK:     BCC .bb1
; CHECK:     BNE .bb3
; CHECK:     CMP $02
; CHECK:     BCS .bb3
; CHECK: .bb1:
; CHECK:     LDX #$FF
; CHECK: .bb2:
; CHECK:     STX $02
; CHECK:     STX $03
; CHECK:     TXA
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     LDX #$00
; CHECK:     JMP .bb2

func @AndBool : (i16, i16, i16) -> i8 {
bb0(%0 : i16, %1 : i16, %2 : i16):
    %3 : i1 = arith.cmpi eq, %0, %1
    %4 : i1 = arith.cmpi eq, %1, %2
    %5 : i1 = arith.and %3, %4
    %6 : i8 = cast.zext %5
    core.return %6
}

func @OrBool : (i16, i16, i16) -> i8 {
bb0(%0 : i16, %1 : i16, %2 : i16):
    %3 : i1 = arith.cmpi eq, %0, %1
    %4 : i1 = arith.cmpi eq, %1, %2
    %5 : i1 = arith.or %3, %4
    %6 : i8 = cast.zext %5
    core.return %6
}

func @XorBool : (i16, i16, i16) -> i8 {
bb0(%0 : i16, %1 : i16, %2 : i16):
    %3 : i1 = arith.cmpi eq, %0, %1
    %4 : i1 = arith.cmpi eq, %1, %2
    %5 : i1 = arith.xor %3, %4
    %6 : i8 = cast.zext %5
    core.return %6
}

func @ZextBool16 : (i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16):
    %2 : i1 = arith.cmpi ult, %0, %1
    %3 : i16 = cast.zext %2
    core.return %3
}

func @SextBool32 : (i16, i16) -> i32 {
bb0(%0 : i16, %1 : i16):
    %2 : i1 = arith.cmpi ult, %0, %1
    %3 : i32 = cast.sext %2
    core.return %3
}
