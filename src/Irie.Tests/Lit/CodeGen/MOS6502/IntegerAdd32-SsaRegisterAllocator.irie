; RUN: IRIE_SSA_RA=1 @iriec --target mos6502 --emit=asm @file

; Pins the SSA-based register allocator (SsaRegisterAllocatorPass, gated behind
; IRIE_SSA_RA=1) on the canonical chained-adc tied-operand case. This is the one
; allocator path otherwise exercised by NO test, so without this golden the SSA
; pipeline could regress silently.
;
; The constrained (tied) adc operands are isolated to single-instruction ranges
; and the i32 carry chain's intermediate bytes are relocated off $a via tay/tax,
; producing output byte-identical to the default graph-colouring allocator here
; (compare IntegerAdd32-CopyElimination.irie). Note the SSA path does NOT yet
; handle functions whose register pressure forces a spill (e.g. a loop with two
; values simultaneously pinned to $a) -- those still throw; see the allocator's
; PreColorSingletonClasses diagnostic.

; CHECK: TestFunction:
; CHECK:     CLC
; CHECK:     ADC $04
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $05
; CHECK:     TAX
; CHECK:     LDA $02
; CHECK:     ADC $06
; CHECK:     STA $02
; CHECK:     LDA $03
; CHECK:     ADC $07
; CHECK:     STA $03
; CHECK:     TYA
; CHECK:     RTS

func @TestFunction : (i32, i32) -> i32 {
bb0(%0 : i32, %1 : i32):
    %2 : i32 = arith.addi %0, %1
    core.return %2
}
