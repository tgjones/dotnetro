; RUN: @iriec --target mos6502 --emit=asm @file

; A call with two i16 arguments: the first (0x1234) is passed in $a/$x and the
; second (0x5678) in $zp2($02)/$zp3($03) per CC_MOS. The placement builds each
; constant byte in the register it is passed in, so the argument setup is a
; sequence of immediate loads with no copies between homes; $a is loaded last.

; CHECK: SinkI16x2:
; CHECK:     RTS
; CHECK:
; CHECK: CallI16x2:
; CHECK:     LDY #$78
; CHECK:     STY $02
; CHECK:     LDX #$56
; CHECK:     STX $03
; CHECK:     LDX #$12
; CHECK:     LDA #$34
; CHECK:     JMP SinkI16x2
; The first argument's low byte is loaded into $a last.

func @SinkI16x2 : (i16, i16) -> void {
bb0(%0 : i16, %1 : i16):
    core.return
}

func @CallI16x2 : () -> void {
bb0():
    %0 : i16 = arith.constant 4660
    %1 : i16 = arith.constant 22136
    call.func @SinkI16x2, %0, %1
    core.return
}
