; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-exec: @irie-exec @file --target mos6502-bbcmicro --emulator @emulator --exec "square(*)" --exec "chain(*, *, *)"

; The beam placement: an argument that arrives in a zero-page register and is passed
; on to a call in the same register needs no code, even though the function has a call.
; In `chain` the second operand of the multiply is already in $02/$03; only the value
; the call does not consume is parked in homes. In `square` the upper bytes stay in
; $02/$03 while the lower bytes are copied to the second operand's registers.

; CHECK: square:
; CHECK:     STA $04
; CHECK:     STX $05
; CHECK:     LDY $02
; CHECK:     STY $06
; CHECK:     LDY $03
; CHECK:     STY $07
; CHECK:     JMP __mulsi3
; CHECK:
; CHECK: chain:
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK:     LDY $04
; CHECK:     STY $16
; CHECK:     LDY $05
; CHECK:     STY $17
; CHECK:     JSR __mulhi3
; CHECK:     CLC
; CHECK:     ADC $16
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     ADC $17
; CHECK:     SEC
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     SBC $14
; CHECK:     TAY
; CHECK:     TXA
; CHECK:     SBC $15
; CHECK:     TAX
; CHECK:     TYA
; CHECK:     RTS

func @square : (i32) -> i32 {
bb0(%0 : i32):
    %1 : i32 = arith.muli %0, %0
    core.return %1
}

func @chain : (i16, i16, i16) -> i16 {
bb0(%0 : i16, %1 : i16, %2 : i16):
    %3 : i16 = arith.muli %0, %1
    %4 : i16 = arith.addi %3, %2
    %5 : i16 = arith.subi %4, %0
    core.return %5
}
