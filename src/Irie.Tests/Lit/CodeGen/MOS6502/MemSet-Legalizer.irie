; RUN: @iriec --target mos6502 --stop-after Legalizer @file

; mem.set has a run-time byte count, so the legalizer lowers it to a call to the memset
; libcall rather than unrolling it as it does mem.fill.

; CHECK: func @TestSet : (ptr, i8, i16) -> void {
; CHECK: bb0():
; CHECK:     [liveins: $a, $x, $zp2, $zp3, $zp4]
; CHECK:     %3 : i8 = pseudo.copy $a
; CHECK:     %4 : i8 = pseudo.copy $x
; CHECK:     %1 : i8 = pseudo.copy $zp2
; CHECK:     %5 : i8 = pseudo.copy $zp3
; CHECK:     %6 : i8 = pseudo.copy $zp4
; CHECK:     $a = pseudo.copy %3
; CHECK:     $x = pseudo.copy %4
; CHECK:     $zp2 = pseudo.copy %1
; CHECK:     $zp3 = pseudo.copy %5
; CHECK:     $zp4 = pseudo.copy %6
; CHECK:     mos6502.jsr.abs @memset, implicit $a, implicit $x, implicit $zp2, implicit $zp3, implicit $zp4, implicit-def $a, implicit-def $x, implicit-def $y, implicit-def $c, implicit-def $n, implicit-def $v, implicit-def $z, implicit-def $b, implicit-def $zp2, implicit-def $zp3, implicit-def $zp4, implicit-def $zp5, implicit-def $zp6, implicit-def $zp7, implicit-def $zp8, implicit-def $zp9, implicit-def $zp10, implicit-def $zp11, implicit-def $zp12, implicit-def $zp13, implicit-def $zp14, implicit-def $zp15, implicit-def $zp16, implicit-def $zp17, implicit-def $zp18, implicit-def $zp19
; CHECK:     pseudo.return
; CHECK: }

func @TestSet : (ptr, i8, i16) -> void {
bb0(%0 : ptr, %1 : i8, %2 : i16):
    mem.set %0, %1, %2
    core.return
}
