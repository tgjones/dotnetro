; RUN: @iriec --target mos6502 --run-pass Inlining @file

; A callee with a loop is cloned block by block into its caller.
func @SumTo : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = arith.constant 0
    cf.br bb1(%1, %0)
bb1(%2 : i16, %3 : i16):
    %4 : i16 = arith.constant 0
    %5 : i1 = arith.cmpi eq, %3, %4
    cf.cond_br %5, bb3, bb2
bb2():
    %6 : i16 = arith.addi %2, %3
    %7 : i16 = arith.constant 1
    %8 : i16 = arith.subi %3, %7
    cf.br bb1(%6, %8)
bb3():
    core.return %2
}

func @UsesSumTo : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @SumTo, %0
    core.return %1
}

; The frame slot of a callee becomes a frame slot of the caller, with a name of its own.
func @Scratch : (i8) -> i8 {
  frame_slot 0 : i8 @Scratch_local0
bb0(%0 : i8):
    %1 : ptr = mem.frame_addr 0
    mem.store.i8 %1, %0
    %2 : i8 = mem.load.i8 %1
    core.return %2
}

func @UsesScratch : (i8) -> i8 {
bb0(%0 : i8):
    %1 : i8 = call.func @Scratch, %0
    core.return %1
}

; A function in a cycle of calls is never inlined, neither into itself nor around the cycle.
func @Recursive : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Recursive, %0
    core.return %1
}

func @Ping : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Pong, %0
    core.return %1
}

func @Pong : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Ping, %0
    core.return %1
}

func @UsesRecursion : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Recursive, %0
    %2 : i16 = call.func @Ping, %1
    core.return %2
}

; A function whose address is taken stays; its direct calls are still inlined when it is small.
global @table : ptr = @Taken

func @Taken : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}

func @CallsTaken : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Taken, %0
    core.return %1
}

; `noinline` keeps a function out of the pass, and a call that names a convention is left alone.
func noinline @Kept : (i16) -> i16 {
bb0(%0 : i16):
    core.return %0
}

func @CallsKept : (i16) -> i16 {
bb0(%0 : i16):
    %1 : i16 = call.func @Kept, %0
    core.return %1
}

func @Rom : (i8) -> i8 {
bb0(%0 : i8):
    core.return %0
}

func @CallsRom : (i8) -> i8 {
bb0(%0 : i8):
    %1 : i8 = call.func @Rom, bbcmicro_os, %0
    core.return %1
}

