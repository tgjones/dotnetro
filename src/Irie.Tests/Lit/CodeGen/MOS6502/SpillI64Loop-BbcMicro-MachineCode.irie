; RUN: @iriec --target mos6502-bbcmicro --emit=asm @file

; Register-pressure regression: two i64 values are loop-carried across a call, far
; more than the 12 callee-saved bytes can hold, so the allocator spills some of
; them. A loop-carried value is defined once per incoming edge (the edge copies
; PHI elimination leaves), so the spill store must follow EVERY def, not just the
; first. The spills (pseudo.spill / pseudo.reload) are lowered once the frame is
; placed: on the BBC Micro target the slots are promoted into the zero-page
; static-frame window ($70..), so each is a direct STA/LDA zp.

; CHECK: Loop64:
; CHECK:     TAY
; CHECK:     LDA $14
; CHECK:     PHA
; CHECK:     LDA $15
; CHECK:     PHA
; CHECK:     LDA $16
; CHECK:     PHA
; CHECK:     LDA $17
; CHECK:     PHA
; CHECK:     LDA $18
; CHECK:     PHA
; CHECK:     LDA $19
; CHECK:     PHA
; CHECK:     LDA $1A
; CHECK:     PHA
; CHECK:     LDA $1B
; CHECK:     PHA
; CHECK:     LDA $1C
; CHECK:     PHA
; CHECK:     LDA $1D
; CHECK:     PHA
; CHECK:     LDA $1E
; CHECK:     PHA
; CHECK:     LDA $1F
; CHECK:     PHA
; CHECK:     TYA
; CHECK:     STA $14
; CHECK:     STX $15
; CHECK:     LDA $08
; CHECK:     STA $09
; CHECK:     LDA #$00
; CHECK:     STA $1A
; CHECK:     LDA #$00
; CHECK:     STA $1C
; CHECK:     LDA #$00
; CHECK:     STA $1E
; CHECK:     LDA #$00
; CHECK:     STA $1F
; CHECK:     LDA #$00
; CHECK:     LDX #$00
; CHECK:     STX $08
; CHECK:     LDX #$00
; CHECK:     LDY #$00
; CHECK:     STA $0A
; CHECK:     LDA $02
; CHECK:     STA $16
; CHECK:     LDA $0A
; CHECK:     STA $02
; CHECK:     LDA $03
; CHECK:     STA $17
; CHECK:     LDA $02
; CHECK:     STA $02
; CHECK:     LDA $04
; CHECK:     STA $18
