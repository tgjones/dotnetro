; CHECK:     STA $15
; CHECK:     PLA
; CHECK:     STA $14
; CHECK:     TYA
; CHECK:     RTS

func @Loop64 : (i64, i8) -> i64 {
bb0(%0 : i64, %1 : i8):
    %2 : i64 = arith.constant 0
    cf.br bb1(%0, %2, %1)
bb1(%3 : i64, %4 : i64, %5 : i8):
    %6 : i64 = call.func @Step, %3
    %7 : i64 = arith.addi %4, %3
    %8 : i8 = arith.constant 1
    %9 : i8 = arith.subi %5, %8
    %10 : i8 = arith.constant 0
    %11 : i1 = arith.cmpi ne, %9, %10
    cf.cond_br %11, bb1(%6, %7, %9), bb2(%7)
bb2(%12 : i64):
    core.return %12
}
