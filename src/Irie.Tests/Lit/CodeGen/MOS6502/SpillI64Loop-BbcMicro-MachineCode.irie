; CHECK:     STA $19
; CHECK:     LDA $02
; CHECK:     STA $02
; CHECK:     LDA $06
; CHECK:     STA $1B
; CHECK:     LDA $02
; CHECK:     STA $02
; CHECK:     LDA $07
; CHECK:     STA $1D
; CHECK:     LDA $02
; CHECK:     STA $70
; CHECK:     LDA $08
; CHECK:     STA $71
; CHECK:     TXA
; CHECK:     STA $72
; CHECK:     TYA
; CHECK:     STA $73
; CHECK:     LDA $09
; CHECK:     STA $74
; CHECK: .bb1:
; CHECK:     LDA $14
