; RUN: @iriec --target mos6502-bbcmicro --emit=asm @file

; Register-pressure regression: two i64 values are loop-carried across a call,
; 16 bytes that must survive every call. They live in zero-page homes (SpillManyLive-Exec
; covers the case that overflows the homes and spills). A loop-carried value is
; defined once per incoming edge (the edge copies PHI elimination leaves), so each
; def must reach the same home.

; CHECK: Loop64:
; CHECK:     LDY $02
; CHECK:     STY $14
; CHECK:     LDY $03
; CHECK:     STY $15
; CHECK:     LDY $04
; CHECK:     STY $16
; CHECK:     LDY $05
; CHECK:     STY $17
; CHECK:     LDY $06
; CHECK:     STY $18
; CHECK:     LDY $07
; CHECK:     STY $19
; CHECK:     LDY #$00
; CHECK:     STY $1A
; CHECK:     STY $1B
; CHECK:     STY $1C
; CHECK:     STY $1D
; CHECK:     STY $1E
; CHECK:     STY $1F
; CHECK:     STY $20
; CHECK:     STY $21
; CHECK:     LDY $08
; CHECK:     STY $22
; CHECK: .bb1:
; CHECK:     STA $23
; CHECK:     STX $24
; CHECK:     LDY $14
; CHECK:     STY $02
; CHECK:     LDY $15
; CHECK:     STY $03
; CHECK:     LDY $16
; CHECK:     STY $04
; CHECK:     LDY $17
; CHECK:     STY $05
; CHECK:     LDY $18
; CHECK:     STY $06
; CHECK:     LDY $19
; CHECK:     STY $07
; CHECK:     JSR Step
; CHECK:     CLC
; CHECK:     TAY
; CHECK:     LDA $1A
; CHECK:     ADC $23
; CHECK:     STA $1A
; CHECK:     LDA $1B
; CHECK:     ADC $24
; CHECK:     STA $1B
; CHECK:     LDA $1C
; CHECK:     ADC $14
; CHECK:     STA $1C
; CHECK:     LDA $1D
; CHECK:     ADC $15
; CHECK:     STA $1D
; CHECK:     LDA $1E
; CHECK:     ADC $16
; CHECK:     STA $1E
; CHECK:     LDA $1F
; CHECK:     ADC $17
; CHECK:     STA $1F
; CHECK:     LDA $20
; CHECK:     ADC $18
; CHECK:     STA $20
; CHECK:     LDA $21
; CHECK:     ADC $19
; CHECK:     STY $23
; CHECK:     LDY $22
; CHECK:     DEY
; CHECK:     BNE .bb3
; CHECK: .bb2:
; CHECK:     LDY $1C
; CHECK:     STY $02
; CHECK:     LDX $1D
; CHECK:     STX $03
; CHECK:     LDY $1E
; CHECK:     STY $04
; CHECK:     LDY $1F
; CHECK:     STY $05
; CHECK:     LDY $20
; CHECK:     STY $06
; CHECK:     STA $07
; CHECK:     LDX $1B
; CHECK:     LDA $1A
; CHECK:     RTS
; CHECK: .bb3:
; CHECK:     STY $22
; CHECK:     LDY $02
; CHECK:     STY $14
; CHECK:     LDY $03
; CHECK:     STY $15
; CHECK:     LDY $04
; CHECK:     STY $16
; CHECK:     LDY $05
; CHECK:     STY $17
; CHECK:     LDY $06
; CHECK:     STY $18
; CHECK:     LDY $07
; CHECK:     STY $19
; CHECK:     STA $21
; CHECK:     LDA $23
; CHECK:     JMP .bb1

func @Loop64 : (i64, i8) -> i64 {
bb0(%0 : i64, %1 : i8):
    %2 : i64 = arith.constant 0
    cf.br bb1(%0, %2, %1)
bb1(%3 : i64, %4 : i64, %5 : i8):
    %6 : i64 = call.func @Step, %3
    %7 : i64 = arith.addi %4, %3
    %8 : i8 = arith.constant 1
    %9 : i8 = arith.subi %5, %8
    %10 : i8 = arith.constant 0
    %11 : i1 = arith.cmpi ne, %9, %10
    cf.cond_br %11, bb1(%6, %7, %9), bb2(%7)
bb2(%12 : i64):
    core.return %12
}
