; RUN: @iriec --target mos6502-bbcmicro --emit=asm @file

; Register-pressure regression: two i64 values are loop-carried across a call,
; 16 bytes that must survive every call. They live in zero-page homes (SpillManyLive-Exec
; covers the case that overflows the homes and spills). A loop-carried value is
; defined once per incoming edge (the edge copies PHI elimination leaves), so each
; def must reach the same home.

; CHECK: Loop64:
; CHECK:     LDY #$00
; CHECK:     STY $1B
; CHECK:     LDY #$00
; CHECK:     STY $1A
; CHECK:     LDY #$00
; CHECK:     STY $19
; CHECK:     LDY #$00
; CHECK:     STY $18
; CHECK:     LDY #$00
; CHECK:     STY $17
; CHECK:     LDY #$00
; CHECK:     STY $16
; CHECK:     LDY #$00
; CHECK:     STY $15
; CHECK:     LDY #$00
; CHECK:     STY $14
; CHECK:     STA $24
; CHECK:     STX $23
; CHECK:     LDA $02
; CHECK:     STA $22
; CHECK:     LDA $03
; CHECK:     STA $21
; CHECK:     LDA $04
; CHECK:     STA $20
; CHECK:     LDA $05
; CHECK:     STA $1F
; CHECK:     LDA $06
; CHECK:     STA $1E
; CHECK:     LDA $07
; CHECK:     STA $1D
; CHECK:     LDA $08
; CHECK:     STA $1C
; CHECK: .bb1:
; CHECK:     LDA $24
; CHECK:     LDX $23
; CHECK:     LDY $22
; CHECK:     STY $02
; CHECK:     LDY $21
; CHECK:     STY $03
; CHECK:     LDY $20
; CHECK:     STY $04
; CHECK:     LDY $1F
; CHECK:     STY $05
; CHECK:     LDY $1E
; CHECK:     STY $06
; CHECK:     LDY $1D
; CHECK:     STY $07
; CHECK:     JSR Step
; CHECK:     STA $08
; CHECK:     CLC
; CHECK:     LDA $1B
; CHECK:     ADC $24
; CHECK:     STA $1B
; CHECK:     LDA $1A
; CHECK:     ADC $23
; CHECK:     STA $1A
; CHECK:     LDA $19
; CHECK:     ADC $22
; CHECK:     STA $19
; CHECK:     LDA $18
; CHECK:     ADC $21
; CHECK:     STA $18
; CHECK:     LDA $17
; CHECK:     ADC $20
; CHECK:     STA $17
; CHECK:     LDA $16
; CHECK:     ADC $1F
; CHECK:     STA $16
; CHECK:     LDA $15
; CHECK:     ADC $1E
; CHECK:     STA $15
; CHECK:     LDA $14
; CHECK:     ADC $1D
; CHECK:     STA $14
; CHECK:     SEC
; CHECK:     LDA $1C
; CHECK:     SBC #$01
; CHECK:     BEQ .bb3
; CHECK: .bb2:
; CHECK:     LDY $08
; CHECK:     STY $24
; CHECK:     STX $23
; CHECK:     LDX $02
; CHECK:     STX $22
; CHECK:     LDX $03
; CHECK:     STX $21
; CHECK:     LDX $04
; CHECK:     STX $20
; CHECK:     LDX $05
; CHECK:     STX $1F
; CHECK:     LDX $06
; CHECK:     STX $1E
; CHECK:     LDX $07
; CHECK:     STX $1D
; CHECK:     STA $1C
; CHECK:     JMP .bb1
; CHECK: .bb3:
; CHECK:     LDA $1B
; CHECK:     LDX $1A
; CHECK:     LDY $19
; CHECK:     STY $02
; CHECK:     LDY $18
; CHECK:     STY $03
; CHECK:     LDY $17
; CHECK:     STY $04
; CHECK:     LDY $16
; CHECK:     STY $05
; CHECK:     LDY $15
; CHECK:     STY $06
; CHECK:     LDY $14
; CHECK:     STY $07
; CHECK:     RTS

func @Loop64 : (i64, i8) -> i64 {
bb0(%0 : i64, %1 : i8):
    %2 : i64 = arith.constant 0
    cf.br bb1(%0, %2, %1)
bb1(%3 : i64, %4 : i64, %5 : i8):
    %6 : i64 = call.func @Step, %3
    %7 : i64 = arith.addi %4, %3
    %8 : i8 = arith.constant 1
    %9 : i8 = arith.subi %5, %8
    %10 : i8 = arith.constant 0
    %11 : i1 = arith.cmpi ne, %9, %10
    cf.cond_br %11, bb1(%6, %7, %9), bb2(%7)
bb2(%12 : i64):
    core.return %12
}
