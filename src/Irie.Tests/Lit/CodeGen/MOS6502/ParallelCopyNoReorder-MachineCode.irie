; RUN: @iriec --target mos6502 --emit=asm @file

; A single i16 argument is passed in $a/$x; each byte is loaded straight into
; its register, with no scratch slot and no copy between homes.

; CHECK: SinkI16:
; CHECK:     RTS
; CHECK:
; CHECK: CallI16:
; CHECK:     LDX #$12
; CHECK:     LDA #$34
; CHECK:     JMP SinkI16

func @SinkI16 : (i16) -> void {
bb0(%0 : i16):
    core.return
}

func @CallI16 : () -> void {
bb0():
    %0 : i16 = arith.constant 4660
    call.func @SinkI16, %0
    core.return
}
