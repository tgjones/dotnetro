; RUN: @iriec --target mos6502 --emit=asm @file
; RUN-bin: @iriec --target mos6502 --emit=bin --origin=0x1000 @file | @irie-mc --hex-dump

; A 16-bit load+store of a global resolves to ABSOLUTE addressing (lda/sta of the
; symbol directly), not a runtime zero-page pointer + (zp),Y. The high byte uses
; a symbol with a +1 offset (g+1), which must round-trip through asm text AND the
; binary encoder.

; CHECK: load_store_global:
; CHECK:     LDA g
; CHECK:     LDX g+1
; CHECK:     STA g
; CHECK:     STX g+1
; CHECK:     RTS

; The two bytes are loaded into A and X and stored straight back (STA/STX
; absolute), and they are also the return value, so nothing is transferred.
; Layout at $1000: the 13-byte function, then g (2 bytes) at $100D/$100E.
;   AD 0D 10  LDA $100D (g)        AE 0E 10  LDX $100E (g+1)   <- +1 offset applied
;   8D 0D 10  STA $100D (g)        8E 0E 10  STX $100E (g+1)
;   60  RTS
; CHECK-bin: 00000000: AD 0D 10 AE 0E 10 8D 0D  10 8E 0E 10 60 00 00

global @g : i16 = bytes "\x00\x00"
func @load_store_global : () -> i16 {
bb0():
    %0 : ptr = mem.symbol @g
    %1 : i16 = mem.load.i16 %0
    mem.store.i16 %0, %1
    core.return %1
}
