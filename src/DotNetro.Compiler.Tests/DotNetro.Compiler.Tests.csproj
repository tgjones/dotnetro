<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Instrumenting tier-0 code for PGO makes the first, JIT-heavy seconds of a test run several times slower, and the lit tests run the compiler in-process. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lit tests compile in parallel and allocate heavily; workstation GC leaves most cores idle waiting for collections. -->
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetro.Compiler.Driver/DotNetro.Compiler.Driver.csproj" />
    <ProjectReference Include="..\DotLit\DotLit.csproj" />
    <ProjectReference Include="..\DotNetro.Compiler\DotNetro.Compiler.csproj" />
    <!-- DotNetro.CoreLib is data for the compiler (read as metadata + IL), not a reference to compile
         against: its System.Object would clash with the real one. Copy it beside the binary instead,
         in a folder per target. -->
    <ProjectReference Include="..\DotNetro.CoreLib.BbcMicro\DotNetro.CoreLib.BbcMicro.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest"
                      Link="corelib\bbcmicro\DotNetro.CoreLib.dll" />
    <ProjectReference Include="..\DotNetro.CoreLib.C64\DotNetro.CoreLib.C64.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest"
                      Link="corelib\c64\DotNetro.CoreLib.dll" />
    <ProjectReference Include="..\DotNetro.Compiler.Tests.CsCompiler\DotNetro.Compiler.Tests.CsCompiler.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DotNetro.Compiler.Tests.DotNetRunner\DotNetro.Compiler.Tests.DotNetRunner.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DotNetro.Compiler.Tests.Emulator\DotNetro.Compiler.Tests.Emulator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Aemula.Chips.Mos6502">
      <HintPath>..\..\lib\Aemula\Aemula.Chips.Mos6502.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Lit\**\*" />
    <None Include="Lit\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
